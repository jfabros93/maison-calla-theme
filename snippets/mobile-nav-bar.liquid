{%- comment -%}
  Mobile bottom navigation bar with glass effect
  Replaces the existing mobile book bar
{%- endcomment -%}

<style>
  .mobile-nav-bar {
    position: fixed;
    bottom: 8px;
    left: 8px;
    right: 8px;
    z-index: 40;
    background-color: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 16px 20px rgba(21, 21, 21, 0.12), 0 16px 40px rgba(21, 21, 21, 0.12);
    border-radius: var(--radius-pill);
    height: 78px;
    padding: 8px 14px calc(8px + env(safe-area-inset-bottom)) 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  @media (min-width: 768px) {
    .mobile-nav-bar {
      display: none;
    }
  }
  
  .mobile-nav-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: var(--color-text-muted);
    font-family: Inter, var(--font-body);
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    transition: color var(--transition-speed) var(--transition-easing);
    min-width: 52px;
    padding: 8px 4px;
  }
  
  .mobile-nav-bar__item:hover {
    color: var(--color-text);
  }
  
  .mobile-nav-bar__item.active {
    color: var(--color-text);
  }
  
  .mobile-nav-bar__icon {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .mobile-nav-bar__icon svg {
    width: 20px;
    height: 20px;
  }
  
  .mobile-nav-bar__label {
    font-size: 13px;
    line-height: 16px;
  }
  
  .mobile-nav-bar__book {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: var(--color-text);
    color: var(--color-surface);
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(21, 21, 21, 0.2);
    transition: all var(--transition-speed) var(--transition-easing);
    flex-shrink: 0;
  }
  
  .mobile-nav-bar__book svg {
    width: 22px;
    height: 22px;
  }
  
  .mobile-nav-bar__book:hover {
    background-color: var(--color-sage-deep);
    transform: translateY(-2px);
  }
</style>

<nav class="mobile-nav-bar" role="navigation" aria-label="Mobile navigation">
  <a href="{{ routes.root_url }}" class="mobile-nav-bar__item{% if template.name == 'index' %} active{% endif %}">
    <span class="mobile-nav-bar__icon">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 7.5l8-6 8 6v9.5a1.5 1.5 0 01-1.5 1.5h-13A1.5 1.5 0 012 17V7.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M7 18V10h6v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="mobile-nav-bar__label">Home</span>
  </a>
  
  <a href="{{ collections['treatments'].url | default: '/collections/treatments' }}" class="mobile-nav-bar__item{% if collection.handle == 'treatments' %} active{% endif %}">
    <span class="mobile-nav-bar__icon">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="10" cy="3.5" r="2.5" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="10" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="10" cy="16.5" r="2.5" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </span>
    <span class="mobile-nav-bar__label">Treatments</span>
  </a>
  
  {%- liquid
    assign book_link = settings.mobile_book_bar_link
    if book_link == blank and settings.booking_page != blank
      assign book_link = pages[settings.booking_page].url
    endif
  -%}
  
  <a 
    href="{{ book_link | default: '#book' }}" 
    class="mobile-nav-bar__book"
    data-book-cta
    data-cta-type="book"
    aria-label="Book treatment"
  >
    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="2" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M15 1v4M7 1v4M2 9h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </a>
  
  <a href="{{ collections.all.url | default: '/collections/all' }}" class="mobile-nav-bar__item{% if template.name == 'collection' and collection.handle != 'treatments' %} active{% endif %}">
    <span class="mobile-nav-bar__icon">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="7.5" cy="17.5" r="1" fill="currentColor"/>
        <circle cx="16.5" cy="17.5" r="1" fill="currentColor"/>
        <path d="M1 1h3.5l2.2 11h8l2-8H5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="mobile-nav-bar__label">Shop</span>
  </a>
  
  <button type="button" class="mobile-nav-bar__item" data-favorites-toggle aria-label="Favorites">
    <span class="mobile-nav-bar__icon">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.37 3.84a4.5 4.5 0 00-6.37 0L10 4.84l-.88-.88a4.5 4.5 0 00-6.37 6.37l.88.88L10 17.69l6.37-6.37.88-.88a4.5 4.5 0 000-6.37z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="mobile-nav-bar__label">Saved</span>
  </button>
</nav>

<script>
  (function() {
    const bookButtons = document.querySelectorAll('[data-book-cta]');
    
    bookButtons.forEach(function(button) {
      button.addEventListener('click', function(e) {
        const ctaType = this.getAttribute('data-cta-type') || 'book';
        
        if (typeof window.dataLayer !== 'undefined') {
          window.dataLayer.push({
            event: 'cta_click',
            cta_type: ctaType,
            cta_location: this.className
          });
        }
        
        const event = new CustomEvent('maison:book_click', {
          detail: {
            type: ctaType,
            location: this.className
          }
        });
        window.dispatchEvent(event);
        
        {%- if settings.mobile_book_bar_app_trigger != blank -%}
          e.preventDefault();
          try {
            {{ settings.mobile_book_bar_app_trigger }}
          } catch (error) {
            console.error('Booking app trigger error:', error);
            if (this.href && this.href !== '#book') {
              window.location.href = this.href;
            }
          }
        {%- endif -%}
      });
    });
  })();
</script>
