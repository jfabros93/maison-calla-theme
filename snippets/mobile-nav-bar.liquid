{%- comment -%}
  Mobile bottom navigation bar with glass effect
  Replaces the existing mobile book bar
{%- endcomment -%}

<style>
  .mobile-nav-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 40;
    background-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(218, 212, 203, 0.4);
    box-shadow: 0 -4px 16px rgba(21, 21, 21, 0.08);
    padding: var(--spacing-2) var(--spacing-3) calc(var(--spacing-2) + env(safe-area-inset-bottom));
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
  }
  
  @media (min-width: 768px) {
    .mobile-nav-bar {
      display: none;
    }
  }
  
  .mobile-nav-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-1);
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: var(--font-size-eyebrow);
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color var(--transition-speed) var(--transition-easing);
    min-width: 60px;
    padding: var(--spacing-1);
  }
  
  .mobile-nav-bar__item:hover {
    color: var(--color-text);
  }
  
  .mobile-nav-bar__item.active {
    color: var(--color-text);
  }
  
  .mobile-nav-bar__icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .mobile-nav-bar__label {
    font-size: 11px;
    text-transform: capitalize;
  }
  
  .mobile-nav-bar__book {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: var(--color-text);
    color: var(--color-surface);
    text-decoration: none;
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    box-shadow: 0 4px 12px rgba(21, 21, 21, 0.2);
    transition: all var(--transition-speed) var(--transition-easing);
    position: relative;
    top: -8px;
  }
  
  .mobile-nav-bar__book:hover {
    background-color: var(--color-sage-deep);
    transform: translateY(-2px);
  }
</style>

<nav class="mobile-nav-bar" role="navigation" aria-label="Mobile navigation">
  <a href="{{ routes.root_url }}" class="mobile-nav-bar__item{% if template.name == 'index' %} active{% endif %}">
    <span class="mobile-nav-bar__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M9 22V12h6v10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="mobile-nav-bar__label">Home</span>
  </a>
  
  <a href="{{ collections['treatments'].url | default: '/collections/treatments' }}" class="mobile-nav-bar__item{% if collection.handle == 'treatments' %} active{% endif %}">
    <span class="mobile-nav-bar__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2a3 3 0 100 6 3 3 0 000-6zM12 9a3 3 0 100 6 3 3 0 000-6zM12 16a3 3 0 100 6 3 3 0 000-6z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="mobile-nav-bar__label">Treatments</span>
  </a>
  
  {%- liquid
    assign book_link = settings.mobile_book_bar_link
    if book_link == blank and settings.booking_page != blank
      assign book_link = pages[settings.booking_page].url
    endif
  -%}
  
  <a 
    href="{{ book_link | default: '#book' }}" 
    class="mobile-nav-bar__book"
    data-book-cta
    data-cta-type="book"
    aria-label="Book treatment"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </a>
  
  <a href="{{ collections.all.url | default: '/collections/all' }}" class="mobile-nav-bar__item{% if template.name == 'collection' and collection.handle != 'treatments' %} active{% endif %}">
    <span class="mobile-nav-bar__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="9" cy="21" r="1" fill="currentColor"/>
        <circle cx="20" cy="21" r="1" fill="currentColor"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="mobile-nav-bar__label">Shop</span>
  </a>
  
  <button type="button" class="mobile-nav-bar__item" data-favorites-toggle aria-label="Favorites">
    <span class="mobile-nav-bar__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
    <span class="mobile-nav-bar__label">Saved</span>
  </button>
</nav>

<script>
  (function() {
    const bookButtons = document.querySelectorAll('[data-book-cta]');
    
    bookButtons.forEach(function(button) {
      button.addEventListener('click', function(e) {
        const ctaType = this.getAttribute('data-cta-type') || 'book';
        
        if (typeof window.dataLayer !== 'undefined') {
          window.dataLayer.push({
            event: 'cta_click',
            cta_type: ctaType,
            cta_location: this.className
          });
        }
        
        const event = new CustomEvent('maison:book_click', {
          detail: {
            type: ctaType,
            location: this.className
          }
        });
        window.dispatchEvent(event);
        
        {%- if settings.mobile_book_bar_app_trigger != blank -%}
          e.preventDefault();
          try {
            {{ settings.mobile_book_bar_app_trigger }}
          } catch (error) {
            console.error('Booking app trigger error:', error);
            if (this.href && this.href !== '#book') {
              window.location.href = this.href;
            }
          }
        {%- endif -%}
      });
    });
  })();
</script>
