{%- comment -%}
  Product card for shop carousel with tinted background, glassy Buy now pill, dark price pill
  
  Parameters:
  - product: Product object
  - demo: Boolean for demo mode
  - index: Integer for demo card number
{%- endcomment -%}

{%- liquid
  if demo
    assign card_title = 'Vitamin C Serum'
    assign card_subtitle = 'Brightening concentrate'
    assign card_price = 65
    assign card_size = '30ml'
    assign card_category = 'Serums'
    assign card_category_handle = 'serums'
    assign card_url = '#'
    assign card_image = blank
    
    if index == 2
      assign card_title = 'Hyaluronic Moisturizer'
      assign card_subtitle = 'Deep hydration cream'
      assign card_price = 48
      assign card_size = '50ml'
      assign card_category = 'Moisturizers'
      assign card_category_handle = 'moisturizers'
    elsif index == 3
      assign card_title = 'Gentle Cleanser'
      assign card_subtitle = 'pH-balanced formula'
      assign card_price = 32
      assign card_size = '150ml'
      assign card_category = 'Cleansers'
      assign card_category_handle = 'cleansers'
    elsif index == 4
      assign card_title = 'Daily SPF 50'
      assign card_subtitle = 'Mineral sunscreen'
      assign card_price = 42
      assign card_size = '50ml'
      assign card_category = 'SPF'
      assign card_category_handle = 'spf'
    elsif index == 5
      assign card_title = 'Retinol Night Serum'
      assign card_subtitle = 'Anti-aging treatment'
      assign card_price = 78
      assign card_size = '30ml'
      assign card_category = 'Serums'
      assign card_category_handle = 'serums'
    elsif index == 6
      assign card_title = 'Exfoliating Toner'
      assign card_subtitle = 'AHA/BHA blend'
      assign card_price = 38
      assign card_size = '100ml'
      assign card_category = 'Cleansers'
      assign card_category_handle = 'cleansers'
    endif
  else
    assign card_title = product.title
    assign card_subtitle = product.metafields.product.subtitle | default: product.metafields.custom.subtitle | default: product.type
    assign card_price = product.price | money_without_currency | remove: ',' | times: 1
    assign card_size = product.metafields.product.size | default: product.metafields.custom.size | default: product.selected_or_first_available_variant.title
    assign card_url = product.url
    assign card_image = product.featured_image
    assign card_category = product.metafields.product.category | default: product.metafields.custom.category | default: product.type
    assign card_category_handle = card_category | handleize
  endif
  
  assign tint_colors = 'beige,tan,blush,sage' | split: ','
  assign tint_index = index | default: 1 | modulo: 4
  assign tint_color = tint_colors[tint_index]
-%}

<div class="product-card product-card--shop shop-carousel__item" data-category="{{ card_category_handle }}">
  <div class="product-card__media product-card__media--{{ tint_color }}">
    <div class="product-card__media-top">
      <span class="chip chip--glass">Best seller</span>
      <button type="button" class="button button--icon product-card__wishlist" aria-label="Add to wishlist">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 17.5l-6.5-6.5a4 4 0 115.657-5.657l.843.843.843-.843a4 4 0 115.657 5.657L10 17.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
    
    <div class="product-card__media-center">
      {%- if card_image != blank -%}
        <img 
          src="{{ card_image | image_url: width: 400 }}"
          srcset="{{ card_image | image_url: width: 300 }} 300w,
                  {{ card_image | image_url: width: 400 }} 400w"
          sizes="(min-width: 1024px) 300px, (min-width: 768px) 50vw, 85vw"
          alt="{{ card_image.alt | default: card_title | escape }}"
          class="product-card__image"
          width="{{ card_image.width | default: 400 }}"
          height="{{ card_image.height | default: 400 }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    
    <div class="product-card__media-bottom">
      <a href="{{ card_url }}" class="buy-now-pill">
        Buy now
        <span class="buy-now-pill__arrow">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5.83331 14.1667L14.1666 5.83337M14.1666 5.83337H5.83331M14.1666 5.83337V14.1667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
      <span class="price-pill">${{ card_price }}</span>
    </div>
  </div>
  
  <div class="product-card__info">
    <h3 class="product-card__name">
      <a href="{{ card_url }}">{{ card_title }}</a>
    </h3>
    
    {%- if card_subtitle != blank -%}
      <p class="product-card__subtitle">{{ card_subtitle }}</p>
    {%- endif -%}
    
    {%- if card_size != blank -%}
      <p class="product-card__size">{{ card_size | upcase }}</p>
    {%- endif -%}
  </div>
</div>
