{%- comment -%}
  Treatment card with tinted background, chips, favorite button
  
  Parameters:
  - product: Product object
  - demo: Boolean for demo mode
  - index: Integer for demo card number
{%- endcomment -%}

{%- liquid
  if demo
    assign card_title = 'Signature Hydrafacial'
    assign card_description = 'Deep cleansing with gentle exfoliation and intense hydration for immediate glow.'
    assign card_price = 150
    assign card_duration = '60 min'
    assign card_category = 'Facials'
    assign card_category_handle = 'facials'
    assign card_url = '#'
    assign card_image = blank
    
    if index == 2
      assign card_title = 'Botox Treatment'
      assign card_description = 'Smooth fine lines and wrinkles with precision injections by licensed providers.'
      assign card_price = 300
      assign card_category = 'Injectables'
      assign card_category_handle = 'injectables'
    elsif index == 3
      assign card_title = 'Laser Hair Removal'
      assign card_description = 'Permanent hair reduction with advanced laser technology and minimal discomfort.'
      assign card_price = 200
      assign card_duration = '45 min'
      assign card_category = 'Laser'
      assign card_category_handle = 'laser'
    elsif index == 4
      assign card_title = 'Dermaplaning Facial'
      assign card_description = 'Gentle exfoliation removing dead skin and peach fuzz for ultra-smooth texture.'
      assign card_price = 120
      assign card_duration = '50 min'
      assign card_category = 'Facials'
      assign card_category_handle = 'facials'
    elsif index == 5
      assign card_title = 'Body Contouring'
      assign card_description = 'Non-invasive body sculpting to target stubborn areas and enhance natural contours.'
      assign card_price = 450
      assign card_duration = '90 min'
      assign card_category = 'Body'
      assign card_category_handle = 'body'
    elsif index == 6
      assign card_title = 'Chemical Peel'
      assign card_description = 'Renew your skin with professional-grade peels for improved tone and texture.'
      assign card_price = 180
      assign card_duration = '45 min'
      assign card_category = 'Facials'
      assign card_category_handle = 'facials'
    endif
  else
    assign card_title = product.title
    assign card_description = product.description | strip_html | truncate: 100
    assign card_price = product.price
    assign card_url = product.url
    assign card_image = product.featured_image
    assign card_duration = product.metafields.treatment.duration | default: '60 min'
    assign card_category = product.metafields.treatment.category | default: product.type
    assign card_category_handle = card_category | handleize
  endif
  
  assign tint_colors = 'beige,tan,blush,sage' | split: ','
  assign tint_index = index | default: 1 | modulo: 4
  assign tint_color = tint_colors[tint_index]
-%}

<div class="treatment-card" data-category="{{ card_category_handle }}">
  <div class="treatment-card__header treatment-card__header--{{ tint_color }}">
    <div class="treatment-card__header-top">
      <span class="chip chip--glass">{{ card_category }}</span>
      <button 
        type="button" 
        class="button button--icon treatment-card__favorite" 
        aria-label="Add to favorites"
        data-favorite-toggle
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.367 3.842a4.583 4.583 0 00-6.484 0L10 4.725l-.883-.883a4.583 4.583 0 00-6.484 6.483l.883.884L10 17.692l6.484-6.483.883-.884a4.583 4.583 0 000-6.483z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </button>
    </div>
    
    <div class="treatment-card__header-center">
      {%- if card_image != blank -%}
        <img 
          src="{{ card_image | image_url: width: 400 }}"
          srcset="{{ card_image | image_url: width: 300 }} 300w,
                  {{ card_image | image_url: width: 400 }} 400w"
          sizes="(min-width: 1024px) 300px, (min-width: 768px) 50vw, 100vw"
          alt="{{ card_image.alt | default: card_title | escape }}"
          class="treatment-card__image"
          width="{{ card_image.width | default: 400 }}"
          height="{{ card_image.height | default: 400 }}"
          loading="lazy"
        >
      {%- else -%}
        {%- assign product_num = index | default: 1 | modulo: 6 | plus: 1 -%}
        {%- assign fallback_file = 'mc-treatment-0' | append: product_num | append: '.jpg' -%}
        <img
          src="{{ fallback_file | asset_url }}"
          alt="{{ card_title | escape }}, Maison Calla concept"
          class="treatment-card__image"
          width="1600"
          height="1200"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
  
  <div class="treatment-card__body">
    <h3 class="treatment-card__title">
      <a href="{{ card_url }}">{{ card_title }}</a>
    </h3>
    
    <p class="treatment-card__description">{{ card_description }}</p>
    
    <div class="treatment-card__meta">
      {%- if card_duration != blank -%}
        <span class="chip chip--subtle">{{ card_duration }}</span>
      {%- endif -%}
      <span class="chip chip--subtle">No downtime</span>
    </div>
    
    <div class="treatment-card__footer">
      <div class="treatment-card__price">
        <div class="treatment-card__price-label">From</div>
        <div class="treatment-card__price-value">
          {%- if demo -%}
            ${{ card_price }}
          {%- else -%}
            {{ card_price | money }}
          {%- endif -%}
        </div>
      </div>
      
      <a href="{{ card_url }}" class="button button--compact button--primary">
        Book
      </a>
    </div>
  </div>
</div>

<script>
  (function() {
    const favoriteButtons = document.querySelectorAll('[data-favorite-toggle]');
    
    favoriteButtons.forEach(function(button) {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        this.classList.toggle('active');
        
        const isActive = this.classList.contains('active');
        this.setAttribute('aria-label', isActive ? 'Remove from favorites' : 'Add to favorites');
        
        const svg = this.querySelector('svg path');
        if (svg) {
          svg.setAttribute('fill', isActive ? 'currentColor' : 'none');
        }
      });
    });
  })();
</script>
