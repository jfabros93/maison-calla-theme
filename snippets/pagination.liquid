{%- comment -%}
  Pagination
  Usage: {% render 'pagination', paginate: paginate %}
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  <style>
    .pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--spacing-sm);
      list-style: none;
      padding: 0;
      margin: 0;
    }
    
    .pagination__item {
      min-width: var(--tap-target-min);
      min-height: var(--tap-target-min);
    }
    
    .pagination__link {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: var(--tap-target-min);
      min-height: var(--tap-target-min);
      padding: var(--spacing-sm);
      text-decoration: none;
      color: var(--color-text);
      border: 1px solid var(--color-stone);
      transition: all var(--transition-speed) var(--transition-easing);
    }
    
    .pagination__link:hover {
      background-color: var(--color-soft-black);
      color: var(--color-ivory);
      border-color: var(--color-soft-black);
    }
    
    .pagination__link--current {
      background-color: var(--color-accent);
      color: var(--color-ivory);
      border-color: var(--color-accent);
    }
    
    .pagination__link--disabled {
      opacity: 0.3;
      cursor: not-allowed;
      pointer-events: none;
    }
  </style>

  <nav role="navigation" aria-label="Pagination">
    <ul class="pagination">
      {%- if paginate.previous -%}
        <li class="pagination__item">
          <a href="{{ paginate.previous.url }}" class="pagination__link" aria-label="Previous page">
            {% render 'icon', icon: 'chevron-left' %}
          </a>
        </li>
      {%- else -%}
        <li class="pagination__item">
          <span class="pagination__link pagination__link--disabled" aria-label="Previous page">
            {% render 'icon', icon: 'chevron-left' %}
          </span>
        </li>
      {%- endif -%}
      
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <li class="pagination__item">
            <a href="{{ part.url }}" class="pagination__link" aria-label="Page {{ part.title }}">
              {{ part.title }}
            </a>
          </li>
        {%- else -%}
          {%- if part.title == paginate.current_page -%}
            <li class="pagination__item">
              <span class="pagination__link pagination__link--current" aria-current="page" aria-label="Current page, page {{ part.title }}">
                {{ part.title }}
              </span>
            </li>
          {%- else -%}
            <li class="pagination__item">
              <span class="pagination__link pagination__link--disabled">{{ part.title }}</span>
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      
      {%- if paginate.next -%}
        <li class="pagination__item">
          <a href="{{ paginate.next.url }}" class="pagination__link" aria-label="Next page">
            {% render 'icon', icon: 'chevron-right' %}
          </a>
        </li>
      {%- else -%}
        <li class="pagination__item">
          <span class="pagination__link pagination__link--disabled" aria-label="Next page">
            {% render 'icon', icon: 'chevron-right' %}
          </span>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
