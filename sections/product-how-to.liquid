<style>
  .product-how-to {
    padding: var(--spacing-16) 0;
    background: var(--color-bg);
  }
  
  .product-how-to__heading {
    font-size: 36px;
    line-height: 42px;
    font-weight: 600;
    margin-bottom: var(--spacing-8);
  }
  
  .product-how-to__steps {
    display: grid;
    gap: var(--spacing-6);
  }
  
  @media (min-width: 768px) {
    .product-how-to__steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .how-to-step {
    padding: var(--spacing-6);
    border-radius: var(--radius-lg);
  }
  
  .how-to-step--beige {
    background: var(--color-beige);
  }
  
  .how-to-step--blush {
    background: var(--color-blush);
  }
  
  .how-to-step--sage {
    background: var(--color-sage-soft);
  }
  
  .how-to-step__title {
    font-size: 20px;
    line-height: 28px;
    font-weight: 600;
    margin-bottom: var(--spacing-2);
  }
  
  .how-to-step__description {
    font-size: 15px;
    line-height: 22px;
    color: var(--color-text-muted);
  }
</style>

<section class="product-how-to section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="product-how-to__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    
    {%- if section.blocks.size > 0 -%}
      <div class="product-how-to__steps">
        {%- assign colors = 'beige,blush,sage' | split: ',' -%}
        {%- for block in section.blocks -%}
          {%- assign color_index = forloop.index0 | modulo: 3 -%}
          {%- assign color = colors[color_index] -%}
          <div class="how-to-step how-to-step--{{ color }}" {{ block.shopify_attributes }}>
            <h3 class="how-to-step__title">{{ block.settings.title }}</h3>
            <p class="how-to-step__description">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product How To",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to use"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "AM + PM"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Apply 3-5 drops to clean, damp skin. Use it twice a day for stronger results."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product How To"
    }
  ]
}
{% endschema %}
