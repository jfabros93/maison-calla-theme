{%- comment -%}
  Locations List - Display multiple spa locations
{%- endcomment -%}

<style>
  .locations-list {
    background-color: var(--color-bg);
  }
  
  .locations-list__header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }
  
  .locations-list__heading {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-md);
  }
  
  .locations-list__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
  
  @media (min-width: 768px) {
    .locations-list__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  .location-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-stone);
    padding: var(--spacing-xl);
    transition: transform var(--transition-speed) var(--transition-easing);
  }
  
  .location-card:hover {
    transform: translateY(-4px);
  }
  
  .location-card__name {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-md);
  }
  
  .location-card__address {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
    line-height: 1.6;
  }
  
  .location-card__hours {
    margin-bottom: var(--spacing-md);
  }
  
  .location-card__hours-title {
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  
  .location-card__hours-list {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.6;
  }
  
  .location-card__phone {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-text);
    text-decoration: none;
    margin-bottom: var(--spacing-lg);
    font-weight: 500;
  }
  
  .location-card__phone:hover {
    color: var(--color-accent);
  }
  
  .location-card__actions {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  
  @media (min-width: 768px) {
    .location-card__actions {
      flex-direction: row;
    }
  }
</style>

<section class="locations-list section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="locations-list__header">
        <h2 class="locations-list__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    
    <div class="locations-list__grid">
      {%- for block in section.blocks -%}
        <article class="location-card" {{ block.shopify_attributes }}>
          <h3 class="location-card__name">{{ block.settings.name }}</h3>
          
          {%- if block.settings.address != blank -%}
            <address class="location-card__address">
              {{ block.settings.address | newline_to_br }}
            </address>
          {%- endif -%}
          
          {%- if block.settings.hours != blank -%}
            <div class="location-card__hours">
              <div class="location-card__hours-title">Hours</div>
              <div class="location-card__hours-list">
                {{ block.settings.hours | newline_to_br }}
              </div>
            </div>
          {%- endif -%}
          
          {%- if block.settings.phone != blank -%}
            <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" class="location-card__phone">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              {{ block.settings.phone }}
            </a>
          {%- endif -%}
          
          <div class="location-card__actions">
            {%- if block.settings.page_url != blank -%}
              <a href="{{ block.settings.page_url }}" class="button">View Location</a>
            {%- endif -%}
            
            <a 
              href="{{ block.settings.book_link | default: '#book' }}" 
              class="button button--primary"
              data-book-cta
              data-cta-type="book"
              data-treatment-name="Appointment at {{ block.settings.name | escape }}"
            >
              Book Here
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Locations List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Locations"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Location Name",
          "default": "Downtown Maison Calla"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "123 Main Street\nSuite 100\nCity, State 12345"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone Number",
          "default": "(555) 123-4567"
        },
        {
          "type": "textarea",
          "id": "hours",
          "label": "Hours (one per line)",
          "default": "Mon-Fri: 9am - 7pm\nSat: 10am - 5pm\nSun: Closed"
        },
        {
          "type": "url",
          "id": "page_url",
          "label": "Location Page Link"
        },
        {
          "type": "url",
          "id": "book_link",
          "label": "Booking Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Locations List"
    }
  ]
}
{% endschema %}
