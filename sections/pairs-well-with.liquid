{%- comment -%}
  Pairs well with section - shows related treatments and products
{%- endcomment -%}

<style>
  .pairs-well-with {
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
  }
  
  .pairs-well-with__subsection {
    margin-bottom: var(--spacing-10);
  }
  
  .pairs-well-with__subsection:last-child {
    margin-bottom: 0;
  }
  
  .pairs-well-with__subsection-title {
    font-size: var(--font-size-h3);
    margin-bottom: var(--spacing-5);
  }
</style>

<section class="pairs-well-with">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 style="font-size: var(--font-size-h2); margin-bottom: var(--spacing-8);">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    
    {%- if section.settings.show_treatments and section.settings.treatments_collection != blank -%}
      <div class="pairs-well-with__subsection">
        <h3 class="pairs-well-with__subsection-title">{{ section.settings.treatments_title | default: 'Add-on treatments' }}</h3>
        <div class="grid grid--3-col">
          {%- assign treatments_collection = collections[section.settings.treatments_collection] -%}
          {%- if treatments_collection != blank and treatments_collection.products.size > 0 -%}
            {%- for product in treatments_collection.products limit: 3 -%}
              {% render 'treatment-card', product: product %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              {% render 'treatment-card', product: blank, demo: true, index: i %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    
    {%- if section.settings.show_products and section.settings.products_collection != blank -%}
      <div class="pairs-well-with__subsection">
        <h3 class="pairs-well-with__subsection-title">{{ section.settings.products_title | default: 'Aftercare products' }}</h3>
        <div class="grid grid--4-col">
          {%- assign products_collection = collections[section.settings.products_collection] -%}
          {%- if products_collection != blank and products_collection.products.size > 0 -%}
            {%- for product in products_collection.products limit: 4 -%}
              {% render 'product-card-shop', product: product %}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              {% render 'product-card-shop', product: blank, demo: true, index: i %}
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pairs Well With",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs well with"
    },
    {
      "type": "header",
      "content": "Add-on Treatments"
    },
    {
      "type": "checkbox",
      "id": "show_treatments",
      "label": "Show Add-on Treatments",
      "default": true
    },
    {
      "type": "text",
      "id": "treatments_title",
      "label": "Treatments Title",
      "default": "Add-on treatments"
    },
    {
      "type": "collection",
      "id": "treatments_collection",
      "label": "Treatments Collection"
    },
    {
      "type": "header",
      "content": "Aftercare Products"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show Aftercare Products",
      "default": true
    },
    {
      "type": "text",
      "id": "products_title",
      "label": "Products Title",
      "default": "Aftercare products"
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products Collection"
    }
  ],
  "presets": [
    {
      "name": "Pairs Well With"
    }
  ]
}
{% endschema %}
