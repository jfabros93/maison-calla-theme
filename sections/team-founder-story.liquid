<style>
  .team-founder-story {
    padding: var(--spacing-10) 0 var(--spacing-5);
    background: var(--color-page-bg);
  }
  
  .team-founder-story__container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-10);
  }
  
  .team-founder-story__grid {
    display: grid;
    gap: var(--spacing-8);
    align-items: center;
  }
  
  @media (min-width: 1024px) {
    .team-founder-story__grid {
      grid-template-columns: 656px 1fr;
    }
  }
  
  .team-founder-story__content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }
  
  .team-eyebrow {
    font-size: var(--font-size-eyebrow);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-sage-deep);
  }
  
  .team-founder-story__heading {
    font-family: var(--font-heading);
    font-size: 3.75rem;
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.035em;
    color: var(--color-text);
  }
  
  .team-founder-story__body {
    font-size: var(--font-size-body-lg);
    line-height: 1.56;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
  }
  
  .team-founder-story__body p {
    margin-bottom: 0;
  }
  
  .team-founder-story__signature {
    font-family: var(--font-heading);
    font-size: var(--font-size-h3);
    font-weight: 600;
    line-height: 1.37;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  
  .team-founder-story__photo-wrap {
    position: relative;
    width: 100%;
    height: 420px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-stone);
  }
  
  @media (min-width: 1024px) {
    .team-founder-story__photo-wrap {
      height: 680px;
    }
  }
  
  .team-founder-story__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  
  @media (max-width: 1023px) {
    .team-founder-story__container {
      padding: 0 var(--spacing-2);
    }
    
    .team-founder-story__grid {
      grid-template-columns: 1fr;
    }
    
    .team-founder-story__heading {
      font-size: 2.625rem;
      line-height: 1.1;
    }
    
    .team-founder-story__body {
      font-size: var(--font-size-body);
    }
  }
</style>

<section class="team-founder-story section">
  <div class="team-founder-story__container">
    <div class="team-founder-story__grid">
      <div class="team-founder-story__content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="team-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h1 class="team-founder-story__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}
        
        {%- if section.settings.body != blank -%}
          <div class="team-founder-story__body">
            {{ section.settings.body }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.signature != blank -%}
          <div class="team-founder-story__signature">{{ section.settings.signature }}</div>
        {%- endif -%}
      </div>
      
      <div class="team-founder-story__photo-wrap">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1120 }}"
            srcset="{{ section.settings.image | image_url: width: 560 }} 560w,
                    {{ section.settings.image | image_url: width: 840 }} 840w,
                    {{ section.settings.image | image_url: width: 1120 }} 1120w"
            sizes="(min-width: 1024px) 560px, 100vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            class="team-founder-story__photo"
            width="560"
            height="680"
            loading="lazy"
          >
        {%- else -%}
          <img
            src="{{ 'mc-team-01.jpg' | asset_url }}"
            alt="{{ section.settings.heading | escape }}"
            class="team-founder-story__photo"
            width="1200"
            height="1600"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Team Founder Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder photo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE HOUSE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Care that feels considered."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Maison Calla began as Dr. Elena Voss's answer to rushed med-spa visits. The house is small on purpose: a medical director on site, a short roster of specialists, and enough time in the room to do the work properly. Every guest is invited to request the same practitioner again.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "Dr. Elena Voss, Founder"
    }
  ],
  "presets": [
    {
      "name": "Team Founder Story"
    }
  ]
}
{% endschema %}
