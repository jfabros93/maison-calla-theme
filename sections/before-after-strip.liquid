{%- comment -%}
  Before/After strip for treatment PDP
{%- endcomment -%}

<style>
  .before-after-strip {
    padding-top: var(--spacing-10);
    padding-bottom: var(--spacing-10);
    background-color: var(--color-surface);
  }
  
  .before-after-strip__grid {
    display: grid;
    gap: var(--spacing-4);
    grid-template-columns: 1fr;
  }
  
  @media (min-width: 768px) {
    .before-after-strip__grid {
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-6);
    }
  }
  
  .before-after-strip__item {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-beige);
  }
  
  .before-after-strip__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .before-after-strip__label {
    position: absolute;
    top: var(--spacing-2);
    left: var(--spacing-2);
    padding: var(--spacing-1) var(--spacing-2);
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--color-text);
  }
</style>

<section class="before-after-strip">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 style="font-size: var(--font-size-h2); margin-bottom: var(--spacing-6); text-align: center;">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    
    <div class="before-after-strip__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image_pair' -%}
          <div class="before-after-strip__item" {{ block.shopify_attributes }}>
            {%- if block.settings.before_image != blank -%}
              <img 
                src="{{ block.settings.before_image | image_url: width: 600 }}"
                alt="Before"
                class="before-after-strip__image"
                width="{{ block.settings.before_image.width | default: 600 }}"
                height="{{ block.settings.before_image.height | default: 600 }}"
                loading="lazy"
              >
            {%- else -%}
              {%- assign pair_num = forloop.index | default: 1 | modulo: 3 | plus: 1 -%}
              {%- assign fallback_file = 'mc-ba-strip-0' | append: pair_num | append: '-before.jpg' -%}
              <img
                src="{{ fallback_file | asset_url }}"
                alt="Before, Maison Calla concept"
                class="before-after-strip__image"
                width="1200"
                height="1200"
                loading="lazy"
              >
            {%- endif -%}
            <span class="before-after-strip__label">Before</span>
          </div>
          
          <div class="before-after-strip__item" {{ block.shopify_attributes }}>
            {%- if block.settings.after_image != blank -%}
              <img 
                src="{{ block.settings.after_image | image_url: width: 600 }}"
                alt="After"
                class="before-after-strip__image"
                width="{{ block.settings.after_image.width | default: 600 }}"
                height="{{ block.settings.after_image.height | default: 600 }}"
                loading="lazy"
              >
            {%- else -%}
              {%- assign pair_num = forloop.index | default: 1 | modulo: 3 | plus: 1 -%}
              {%- assign fallback_file = 'mc-ba-strip-0' | append: pair_num | append: '-after.jpg' -%}
              <img
                src="{{ fallback_file | asset_url }}"
                alt="After, Maison Calla concept"
                class="before-after-strip__image"
                width="1200"
                height="1200"
                loading="lazy"
              >
            {%- endif -%}
            <span class="before-after-strip__label">After</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before/After Strip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before & After"
    }
  ],
  "blocks": [
    {
      "type": "image_pair",
      "name": "Image Pair",
      "settings": [
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before Image"
        },
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After Image"
        }
      ]
    }
  ],
  "max_blocks": 1,
  "presets": [
    {
      "name": "Before/After Strip"
    }
  ]
}
{% endschema %}
