{%- comment -%}
  Reviews/Testimonials Section
  Supports @app blocks for review apps like Stamped, Judge.me, Loox, etc.
{%- endcomment -%}

<style>
  .reviews {
    background-color: var(--color-bg);
  }
  
  .reviews__header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }
  
  .reviews__heading {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-md);
  }
  
  .reviews__subheading {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
  }
  
  .reviews__app-blocks {
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
  
  @media (min-width: 768px) {
    .reviews__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .reviews__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .review-card {
    background-color: var(--color-bg);
    border: 1px solid var(--color-stone);
    padding: var(--spacing-xl);
  }
  
  .review-card__rating {
    color: var(--color-accent);
    margin-bottom: var(--spacing-md);
    font-size: var(--font-size-lg);
  }
  
  .review-card__quote {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: var(--spacing-lg);
    font-style: italic;
  }
  
  .review-card__quote::before {
    content: '"';
    font-size: var(--font-size-2xl);
    color: var(--color-accent);
    line-height: 0;
  }
  
  .review-card__author {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }
  
  .review-card__author-image {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .review-card__author-info {
    flex-grow: 1;
  }
  
  .review-card__author-name {
    font-weight: 600;
    margin-bottom: 2px;
  }
  
  .review-card__author-treatment {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }
</style>

<section class="reviews section">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="reviews__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="reviews__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subheading != blank -%}
          <p class="reviews__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    {%- assign has_app_blocks = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {%- assign has_app_blocks = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    
    {%- if has_app_blocks -%}
      <div class="reviews__app-blocks">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%} Manual testimonial blocks {%- endcomment -%}
      <div class="reviews__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            <article class="review-card" {{ block.shopify_attributes }}>
              {%- if block.settings.rating > 0 -%}
                <div class="review-card__rating">
                  {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
                </div>
              {%- endif -%}
              
              {%- if block.settings.quote != blank -%}
                <blockquote class="review-card__quote">
                  {{ block.settings.quote }}
                </blockquote>
              {%- endif -%}
              
              <div class="review-card__author">
                {%- if block.settings.author_image != blank -%}
                  <img
                    src="{{ block.settings.author_image | image_url: width: 100 }}"
                    alt="{{ block.settings.author_name | escape }}"
                    class="review-card__author-image"
                    loading="lazy"
                    width="50"
                    height="50"
                  >
                {%- endif -%}
                
                <div class="review-card__author-info">
                  {%- if block.settings.author_name != blank -%}
                    <div class="review-card__author-name">{{ block.settings.author_name }}</div>
                  {%- endif -%}
                  
                  {%- if block.settings.treatment != blank -%}
                    <div class="review-card__author-treatment">{{ block.settings.treatment }}</div>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Clients Say"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real experiences from real clients"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review Text",
          "default": "The results exceeded my expectations. The staff is professional and the facility is beautiful."
        },
        {
          "type": "image_picker",
          "id": "author_image",
          "label": "Author Photo (Optional)"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Jennifer M."
        },
        {
          "type": "text",
          "id": "treatment",
          "label": "Treatment",
          "default": "Hydrafacial Treatment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Life-changing results! The team at Maison Calla truly cares about their clients and it shows in everything they do.",
            "author_name": "Sarah K.",
            "treatment": "Laser Skin Resurfacing"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "Professional, clean, and the results speak for themselves. I finally found a place I trust with my skin.",
            "author_name": "Michael R.",
            "treatment": "Injectable Treatments"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "The consultation was thorough and educational. I felt confident in my treatment plan from day one.",
            "author_name": "Lisa T.",
            "treatment": "Chemical Peel"
          }
        }
      ]
    }
  ]
}
{% endschema %}
