<style>
  .footer {
    background: var(--color-beige);
    color: var(--color-text);
  }
  
  .footer__cta {
    padding: var(--spacing-16) 0;
    border-bottom: 1px solid var(--color-line);
  }
  
  .footer__cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-6);
    flex-wrap: wrap;
  }
  
  .footer__cta-text {
    font-size: 36px;
    line-height: 42px;
    font-weight: 600;
  }
  
  .footer__main {
    padding: var(--spacing-12) 0;
    display: grid;
    gap: var(--spacing-10);
  }
  
  @media (min-width: 1024px) {
    .footer__main {
      grid-template-columns: 400px 1fr;
      gap: var(--spacing-15);
    }
  }
  
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }
  
  .footer__logo {
    max-width: 180px;
  }
  
  .footer__newsletter-heading {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: var(--spacing-3);
  }
  
  .footer__newsletter-form {
    position: relative;
    max-width: 360px;
  }
  
  .footer__newsletter-input {
    width: 100%;
    padding: var(--spacing-3) var(--spacing-15) var(--spacing-3) var(--spacing-4);
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: 15px;
    background: transparent;
  }
  
  .footer__newsletter-input:focus {
    outline: none;
    border-color: var(--color-text);
  }
  
  .footer__newsletter-button {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    padding: var(--spacing-2) var(--spacing-4);
    background: var(--color-text);
    color: var(--color-surface);
    border: none;
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  
  .footer__menus {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--spacing-8);
  }
  
  @media (min-width: 768px) {
    .footer__menus {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .footer__menu-heading {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: var(--spacing-4);
  }
  
  .footer__menu-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
  
  .footer__menu-link {
    color: var(--color-text);
    text-decoration: none;
    font-size: 15px;
    line-height: 22px;
  }
  
  .footer__menu-link:hover {
    text-decoration: underline;
  }
  
  .footer__bottom {
    padding: var(--spacing-6) 0;
    border-top: 1px solid var(--color-line);
  }
  
  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4);
    flex-wrap: wrap;
  }
  
  .footer__legal {
    font-size: 14px;
    color: var(--color-text-muted);
  }
  
  .footer__bottom-right {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }
  
  .footer__concept-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-3);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: 13px;
    text-decoration: none;
    color: var(--color-text);
  }
  
  .footer__concept-pill img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
  
  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-text);
    text-decoration: none;
  }
  
  .footer__social-link:hover {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-surface);
  }
</style>

<footer class="footer section">
  <div class="container">
    <!-- CTA Row -->
    {%- if section.settings.cta_text != blank or section.settings.cta_button_text != blank -%}
      <div class="footer__cta">
        <div class="footer__cta-inner">
          {%- if section.settings.cta_text != blank -%}
            <h2 class="footer__cta-text">{{ section.settings.cta_text }}</h2>
          {%- endif -%}
          {%- if section.settings.cta_button_text != blank -%}
            <a href="{{ section.settings.cta_button_link | default: '/pages/booking' }}" class="button button--primary">
              {{ section.settings.cta_button_text }}
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
    
    <!-- Main Footer Content -->
    <div class="footer__main">
      <!-- Brand + Newsletter -->
      <div class="footer__brand">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 360 }}" alt="{{ shop.name }}" class="footer__logo" width="180" height="auto" loading="lazy">
        {%- else -%}
          <div class="footer__logo" style="font-size: 24px; font-weight: 600;">{{ shop.name }}</div>
        {%- endif -%}
        
        {%- if section.settings.newsletter_heading != blank -%}
          <div class="footer__newsletter">
            <h3 class="footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h3>
            <form method="post" action="/contact#contact_form" id="contact_form" accept-charset="UTF-8" class="footer__newsletter-form">
              <input type="hidden" name="form_type" value="customer" />
              <input type="hidden" name="utf8" value="✓" />
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input 
                type="email" 
                name="contact[email]" 
                id="NewsletterForm--footer" 
                placeholder="Your email" 
                required 
                class="footer__newsletter-input"
              >
              <button type="submit" class="footer__newsletter-button">
                Submit
              </button>
            </form>
          </div>
        {%- endif -%}
      </div>
      
      <!-- Menu Columns -->
      <div class="footer__menus">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            <div class="footer__menu" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h4 class="footer__menu-heading">{{ block.settings.heading }}</h4>
              {%- endif -%}
              
              <ul class="footer__menu-list">
                {%- liquid
                  assign menu_links = linklists[block.settings.menu].links
                  assign has_menu = false
                  if menu_links.size > 0
                    assign has_menu = true
                  endif
                -%}
                
                {%- if has_menu -%}
                  {%- for link in menu_links -%}
                    <li>
                      <a href="{{ link.url }}" class="footer__menu-link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                {%- elsif block.settings.fallback_links != blank -%}
                  {%- assign fallback_lines = block.settings.fallback_links | newline_to_br | split: '<br />' -%}
                  {%- for line in fallback_lines -%}
                    {%- assign parts = line | split: ':' -%}
                    {%- if parts.size == 2 -%}
                      {%- assign link_title = parts[0] | strip -%}
                      {%- assign link_url = parts[1] | strip -%}
                      <li>
                        <a href="{{ link_url }}" class="footer__menu-link">{{ link_title }}</a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    
    <!-- Bottom Row -->
    <div class="footer__bottom">
      <div class="footer__bottom-inner">
        <div class="footer__legal">
          {{ section.settings.legal_text | default: "© 2024 Maison Calla. All rights reserved." }}
        </div>
        
        <div class="footer__bottom-right">
          <a href="https://cursor.com" class="footer__concept-pill" target="_blank" rel="noopener">
            <img src="{{ 'mc-concept-logo.png' | asset_url }}" alt="Concept" width="20" height="20">
            <span>A concept store</span>
          </a>
          
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 6.667a3.333 3.333 0 1 0 0 6.666 3.333 3.333 0 0 0 0-6.666Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M2.5 10c0-3.771 0-5.657 1.172-6.828C4.843 2 6.729 2 10.5 2h-.5c3.771 0 5.657 0 6.828 1.172C18 4.343 18 6.229 18 10c0 3.771 0 5.657-1.172 6.828C15.657 18 13.771 18 10 18c-3.771 0-5.657 0-6.828-1.172C2 15.657 2 13.771 2 10Z" stroke="currentColor" stroke-width="1.5"/>
                <path d="M15 5h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "CTA Section"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Ready when you are"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA Button Text",
      "default": "Book a treatment"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "CTA Button Link",
      "default": "/pages/booking"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Get our emails"
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Legal Text",
      "default": "© 2024 Maison Calla. All rights reserved."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Menu"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Leave blank to use fallback links"
        },
        {
          "type": "textarea",
          "id": "fallback_links",
          "label": "Fallback Links",
          "info": "Format: Title:/url (one per line). Used when menu is not selected.",
          "default": "Link 1:/\nLink 2:/\nLink 3:/"
        }
      ]
    }
  ],
  "default": {
    "settings": {
      "cta_text": "Ready when you are",
      "cta_button_text": "Book a treatment",
      "newsletter_heading": "Get our emails",
      "legal_text": "© 2024 Maison Calla. All rights reserved."
    }
  }
}
{% endschema %}
