{%- comment -%}
  FAQ Section with accordion
{%- endcomment -%}

<style>
  .faq {
    background-color: var(--color-bg);
  }
  
  .faq__header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }
  
  .faq__heading {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-md);
  }
  
  .faq__subheading {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
  }
  
  .faq__list {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .faq-item {
    border-bottom: 1px solid var(--color-stone);
  }
  
  .faq-item__question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg) 0;
    background: none;
    border: none;
    font-family: var(--font-heading);
    font-size: var(--font-size-lg);
    font-weight: 600;
    text-align: left;
    color: var(--color-text);
    cursor: pointer;
    min-height: var(--tap-target-min);
  }
  
  .faq-item__question:hover {
    color: var(--color-accent);
  }
  
  .faq-item__icon {
    flex-shrink: 0;
    margin-left: var(--spacing-md);
    transition: transform var(--transition-speed) var(--transition-easing);
  }
  
  .faq-item.is-open .faq-item__icon {
    transform: rotate(180deg);
  }
  
  .faq-item__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s var(--transition-easing);
  }
  
  .faq-item.is-open .faq-item__answer {
    max-height: 1000px;
  }
  
  .faq-item__answer-content {
    padding-bottom: var(--spacing-lg);
    color: var(--color-text-light);
    line-height: 1.7;
  }
</style>

<section class="faq section">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="faq__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="faq__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subheading != blank -%}
          <p class="faq__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <button 
            type="button"
            class="faq-item__question"
            aria-expanded="false"
            aria-controls="faq-answer-{{ block.id }}"
          >
            <span>{{ block.settings.question }}</span>
            <span class="faq-item__icon">
              {% render 'icon', icon: 'chevron-down' %}
            </span>
          </button>
          
          <div id="faq-answer-{{ block.id }}" class="faq-item__answer">
            <div class="faq-item__answer-content">
              {{ block.settings.answer }}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function() {
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach(item => {
      const button = item.querySelector('.faq-item__question');
      
      button.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');
        
        // Close all items
        faqItems.forEach(otherItem => {
          otherItem.classList.remove('is-open');
          const otherButton = otherItem.querySelector('.faq-item__question');
          otherButton.setAttribute('aria-expanded', 'false');
        });
        
        // Open clicked item if it was closed
        if (!isOpen) {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know about our treatments"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How long does a treatment take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Treatment times vary depending on the service, typically ranging from 30 to 90 minutes.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How do I book an appointment?",
            "answer": "<p>You can book online through our booking system or call us directly.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What should I expect during my first visit?",
            "answer": "<p>Your first visit includes a consultation to discuss your goals and create a personalized treatment plan.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you require a consultation before treatment?",
            "answer": "<p>Some treatments require a consultation. This will be noted on the treatment page.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
