{%- comment -%}
  Main Product Retail - Redesigned with tan circle, attribute icons, size tiles
{%- endcomment -%}

<style>
  .product-retail {
    padding: var(--spacing-4xl) 0;
  }
  
  .product-retail__breadcrumb {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }
  
  .product-retail__grid {
    display: grid;
    gap: var(--spacing-3xl);
  }
  
  @media (min-width: 1024px) {
    .product-retail__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  
  /* Media Card with Tan Circle */
  .product-media-card {
    padding: var(--spacing-3xl);
    background-color: var(--color-tan);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 500px;
    position: relative;
  }
  
  .product-media-card__circle {
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }
  
  .product-media-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  
  .product-media-card__attributes {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  
  /* Product Info */
  .product-retail__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  
  .product-retail__title {
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  
  .product-retail__price {
    font-size: 26px;
    font-weight: 600;
  }
  
  .product-retail__price--compare {
    color: var(--color-text-muted);
    text-decoration: line-through;
    font-size: 19px;
    margin-left: 12px;
  }
  
  .product-retail__description {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  
  .product-retail__provider-rec {
    padding: 16px;
    background-color: var(--color-sage-soft);
    border-radius: var(--radius-sm);
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  /* Attribute Icons */
  .attribute-icons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  
  .attribute-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  
  .attribute-icon__circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-sage-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }
  
  .attribute-icon__label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }
  
  /* Size Variant Tiles */
  .size-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 12px;
  }
  
  .size-tile {
    padding: 16px;
    border: 2px solid var(--color-line);
    border-radius: var(--radius-sm);
    text-align: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    background-color: var(--color-surface);
  }
  
  .size-tile:hover {
    border-color: var(--color-sage);
  }
  
  .size-tile.selected {
    border-color: var(--color-sage);
    background-color: var(--color-sage-soft);
  }
  
  .size-tile__name {
    font-weight: 600;
    font-size: 15px;
  }
  
  /* Quantity Stepper */
  .quantity-stepper {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: 8px;
  }
  
  .quantity-stepper__btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
    font-weight: 600;
  }
  
  .quantity-stepper__input {
    width: 40px;
    text-align: center;
    border: none;
    font-size: 15px;
    font-weight: 600;
  }
  
  /* Ingredients */
  .ingredients-section {
    padding: var(--spacing-lg) 0;
    border-top: 1px solid var(--color-line);
  }
  
  .ingredients__swatches {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  
  .ingredient-swatch {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
  }
  
  .formula-score {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .formula-score__bar {
    flex: 1;
    height: 8px;
    background-color: var(--color-line);
    border-radius: 4px;
    overflow: hidden;
  }
  
  .formula-score__fill {
    height: 100%;
    background-color: var(--color-sage);
  }
  
  .formula-score__label {
    font-size: 14px;
    font-weight: 600;
  }
  
  /* Pickup Toggle */
  .fulfillment-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    background-color: var(--color-subtle-surface);
    border-radius: var(--radius-sm);
  }
  
  /* Mobile Sticky Bar */
  .product-mobile-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-line);
    padding: 16px;
    box-shadow: 0 -4px 16px rgba(21, 21, 21, 0.08);
  }
  
  @media (max-width: 1023px) {
    .product-mobile-bar {
      display: block;
    }
  }
</style>

<div class="product-retail">
  <div class="container">
    <div class="product-retail__grid">
      <div class="product-retail__media">
        {%- if product.featured_media -%}
          <img
            id="product-featured-image"
            srcset="
              {{ product.featured_media | image_url: width: 400 }} 400w,
              {{ product.featured_media | image_url: width: 600 }} 600w,
              {{ product.featured_media | image_url: width: 800 }} 800w,
              {{ product.featured_media | image_url: width: 1000 }} 1000w
            "
            src="{{ product.featured_media | image_url: width: 800 }}"
            sizes="(min-width: 768px) 50vw, 100vw"
            alt="{{ product.featured_media.alt | escape }}"
            class="product-retail__image"
            loading="eager"
            fetchpriority="high"
            width="800"
            height="800"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-retail__image' }}
        {%- endif -%}
        
        {%- if product.media.size > 1 -%}
          <div class="product-retail__thumbnails">
            {%- for media in product.media limit: 4 -%}
              <img
                src="{{ media | image_url: width: 200 }}"
                alt="{{ media.alt | escape }}"
                class="product-retail__thumbnail {% if forloop.first %}active{% endif %}"
                data-media-id="{{ media.id }}"
                data-media-url="{{ media | image_url: width: 800 }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      
      <div class="product-retail__info">
        <h1 class="product-retail__title">{{ product.title }}</h1>
        
        <div class="product-retail__price">
          <span class="product-retail__price--current">
            {{ product.selected_or_first_available_variant.price | money }}
          </span>
          
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
            <span class="product-retail__price--compare">
              {{ product.selected_or_first_available_variant.compare_at_price | money }}
            </span>
          {%- endif -%}
        </div>
        
        {%- if product.description != blank -%}
          <div class="product-retail__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}
        
        <form class="product-retail__form" method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="product-retail__variant-select">
                <label class="product-retail__variant-label" for="option-{{ option.position }}">
                  {{ option.name }}
                </label>
                <select
                  id="option-{{ option.position }}"
                  name="options[{{ option.name }}]"
                  class="product-retail__select"
                >
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}
          
          <div class="product-retail__quantity">
            <label class="product-retail__quantity-label" for="quantity">Quantity</label>
            <input
              type="number"
              id="quantity"
              name="quantity"
              value="1"
              min="1"
              class="product-retail__quantity-input"
            >
          </div>
          
          {%- if product.selected_or_first_available_variant.inventory_management -%}
            {%- assign inventory = product.selected_or_first_available_variant.inventory_quantity -%}
            {%- if inventory > 0 and inventory <= 10 -%}
              <div class="product-retail__inventory product-retail__inventory--low">
                Only {{ inventory }} left in stock
              </div>
            {%- elsif inventory > 0 -%}
              <div class="product-retail__inventory">
                In stock
              </div>
            {%- endif -%}
          {%- endif -%}
          
          <div class="product-retail__actions">
            <button
              type="submit"
              class="button button--primary button--full-width"
              {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
            >
              {% if product.selected_or_first_available_variant.available %}
                {{ 'products.product.add_to_cart' | t }}
              {% else %}
                {{ 'products.product.sold_out' | t }}
              {% endif %}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // Thumbnail image switching
  const thumbnails = document.querySelectorAll('.product-retail__thumbnail');
  const featuredImage = document.getElementById('product-featured-image');
  
  thumbnails.forEach(thumb => {
    thumb.addEventListener('click', () => {
      thumbnails.forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');
      featuredImage.src = thumb.dataset.mediaUrl;
    });
  });
</script>

{% schema %}
{
  "name": "Retail Product",
  "settings": []
}
{% endschema %}
