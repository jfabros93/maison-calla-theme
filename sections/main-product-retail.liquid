{%- comment -%}
  Main Product Retail - Redesigned with tan circle, attribute icons, size tiles
{%- endcomment -%}

<style>
  .product-retail {
    padding: var(--spacing-4xl) 0;
  }
  
  .product-retail__breadcrumb {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }
  
  .product-retail__grid {
    display: grid;
    gap: var(--spacing-3xl);
  }
  
  @media (min-width: 1024px) {
    .product-retail__grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  
  /* Media Card with Tan Circle */
  .product-media-card {
    padding: var(--spacing-3xl);
    background-color: var(--color-tan);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 500px;
    position: relative;
  }
  
  .product-media-card__circle {
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }
  
  .product-media-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  
  .product-media-card__attributes {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  
  /* Product Info */
  .product-retail__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  
  .product-retail__title {
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  
  .product-retail__price {
    font-size: 26px;
    font-weight: 600;
  }
  
  .product-retail__price--compare {
    color: var(--color-text-muted);
    text-decoration: line-through;
    font-size: 19px;
    margin-left: 12px;
  }
  
  .product-retail__description {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  
  .product-retail__provider-rec {
    padding: 16px;
    background-color: var(--color-sage-soft);
    border-radius: var(--radius-sm);
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  /* Attribute Icons */
  .attribute-icons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  
  .attribute-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  
  .attribute-icon__circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-sage-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }
  
  .attribute-icon__label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
  }
  
  /* Size Variant Tiles */
  .size-tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 12px;
  }
  
  .size-tile {
    padding: 16px;
    border: 2px solid var(--color-line);
    border-radius: var(--radius-sm);
    text-align: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    background-color: var(--color-surface);
  }
  
  .size-tile:hover {
    border-color: var(--color-sage);
  }
  
  .size-tile.selected {
    border-color: var(--color-sage);
    background-color: var(--color-sage-soft);
  }
  
  .size-tile__name {
    font-weight: 600;
    font-size: 15px;
  }
  
  /* Quantity Stepper */
  .quantity-stepper {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: 8px;
  }
  
  .quantity-stepper__btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
    font-weight: 600;
  }
  
  .quantity-stepper__input {
    width: 40px;
    text-align: center;
    border: none;
    font-size: 15px;
    font-weight: 600;
  }
  
  /* Ingredients */
  .ingredients-section {
    padding: var(--spacing-lg) 0;
    border-top: 1px solid var(--color-line);
  }
  
  .ingredients__swatches {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  
  .ingredient-swatch {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
  }
  
  .formula-score {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .formula-score__bar {
    flex: 1;
    height: 8px;
    background-color: var(--color-line);
    border-radius: 4px;
    overflow: hidden;
  }
  
  .formula-score__fill {
    height: 100%;
    background-color: var(--color-sage);
  }
  
  .formula-score__label {
    font-size: 14px;
    font-weight: 600;
  }
  
  /* Pickup Toggle */
  .fulfillment-toggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px;
    background-color: var(--color-subtle-surface);
    border-radius: var(--radius-sm);
  }
  
  /* Mobile Sticky Bar */
  .product-mobile-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-line);
    padding: 16px;
    box-shadow: 0 -4px 16px rgba(21, 21, 21, 0.08);
  }
  
  @media (max-width: 1023px) {
    .product-mobile-bar {
      display: block;
    }
  }
</style>

<div class="product-retail">
  <div class="container">
    <div class="product-retail__grid">
      <!-- Gallery Card -->
      <div class="product-media-card">
        <div class="product-media-card__circle">
          {%- if product.featured_media -%}
            <img
              id="product-featured-image"
              src="{{ product.featured_media | image_url: width: 600 }}"
              alt="{{ product.featured_media.alt | escape }}"
              class="product-media-card__image"
              width="600"
              height="600"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            <div style="width: 100%; height: 100%; background-color: var(--color-beige); border-radius: 50%;"></div>
          {%- endif -%}
        </div>
      </div>
      
      <!-- Product Info -->
      <div class="product-retail__info">
        {%- liquid
          assign category = product.metafields.product.category | default: product.metafields.custom.category | default: product.type
          assign subtitle = product.metafields.product.subtitle | default: product.metafields.custom.subtitle
          assign ingredients = product.metafields.product.ingredients | default: product.metafields.custom.ingredients
          assign how_to_use = product.metafields.product.how_to_use | default: product.metafields.custom.how_to_use
        -%}
        
        {%- if category != blank -%}
          <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-text-muted); margin-bottom: 8px;">
            {{ category }}
          </div>
        {%- endif -%}
        
        <h1 class="product-retail__title">{{ product.title }}</h1>
        
        {%- if subtitle != blank -%}
          <p style="font-size: 16px; color: var(--color-text-muted); margin-bottom: var(--spacing-lg);">
            {{ subtitle }}
          </p>
        {%- endif -%}
        
        <div class="product-retail__price">
          {{ product.selected_or_first_available_variant.price | money }}
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
            <span class="product-retail__price--compare">
              {{ product.selected_or_first_available_variant.compare_at_price | money }}
            </span>
          {%- endif -%}
        </div>
        
        <form id="product-form" method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="id" id="variant-id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <!-- Size Pills -->
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div style="margin-bottom: var(--spacing-lg);">
                <label style="display: block; font-weight: 600; margin-bottom: var(--spacing-sm);">
                  {{ option.name }}
                </label>
                <div class="size-tiles">
                  {%- for value in option.values -%}
                    <label class="size-tile {% if option.selected_value == value %}selected{% endif %}">
                      <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} style="display: none;">
                      <div class="size-tile__name">{{ value }}</div>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}
          
          <!-- Quantity Stepper -->
          <div style="margin-bottom: var(--spacing-lg);">
            <label style="display: block; font-weight: 600; margin-bottom: var(--spacing-sm);">Quantity</label>
            <div class="quantity-stepper">
              <button type="button" class="quantity-stepper__btn" onclick="updateQuantity(-1)">−</button>
              <input type="number" name="quantity" id="quantity" value="1" min="1" class="quantity-stepper__input" readonly>
              <button type="button" class="quantity-stepper__btn" onclick="updateQuantity(1)">+</button>
            </div>
          </div>
          
          <!-- Add to Bag Button -->
          <button
            type="submit"
            class="button button--primary button--full-width"
            style="border-radius: var(--radius-pill);"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            {% if product.selected_or_first_available_variant.available %}
              Add to bag · {{ product.selected_or_first_available_variant.price | money }}
            {% else %}
              Sold out
            {% endif %}
          </button>
        </form>
        
        <!-- Key Ingredients Accordion -->
        {%- if ingredients != blank -%}
          <div class="ingredients-section">
            <details>
              <summary style="cursor: pointer; font-weight: 600; margin-bottom: var(--spacing-md);">Key Ingredients</summary>
              <div style="color: var(--color-text-muted); line-height: 1.6;">
                {{ ingredients }}
              </div>
            </details>
          </div>
        {%- endif -%}
        
        <!-- How to Use Accordion -->
        {%- if how_to_use != blank -%}
          <div class="ingredients-section">
            <details>
              <summary style="cursor: pointer; font-weight: 600; margin-bottom: var(--spacing-md);">How to Use</summary>
              <div style="color: var(--color-text-muted); line-height: 1.6;">
                {{ how_to_use }}
              </div>
            </details>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  // Size tile selection
  document.querySelectorAll('.size-tile').forEach(tile => {
    tile.addEventListener('click', () => {
      tile.closest('.size-tiles').querySelectorAll('.size-tile').forEach(t => t.classList.remove('selected'));
      tile.classList.add('selected');
      updateVariant();
    });
  });
  
  // Quantity stepper
  function updateQuantity(change) {
    const input = document.getElementById('quantity');
    const currentValue = parseInt(input.value) || 1;
    const newValue = Math.max(1, currentValue + change);
    input.value = newValue;
  }
  
  // Update variant based on selected options
  function updateVariant() {
    const selectedOptions = Array.from(document.querySelectorAll('.size-tile.selected input')).map(input => input.value);
    // Variant switching logic would go here if needed
  }
</script>

{% schema %}
{
  "name": "Retail Product",
  "settings": []
}
{% endschema %}
