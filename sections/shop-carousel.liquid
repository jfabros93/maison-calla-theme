{%- comment -%}
  Shop best-sellers carousel with product cards
{%- endcomment -%}

<style>
  .shop-carousel {
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
  }
  
  .shop-carousel__controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-6);
  }
  
  .shop-carousel__arrows {
    display: none;
    gap: var(--spacing-2);
  }
  
  @media (min-width: 1024px) {
    .shop-carousel__arrows {
      display: flex;
    }
  }
  
  .shop-carousel__arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--color-line);
    background-color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition-speed) var(--transition-easing);
  }
  
  .shop-carousel__arrow:hover:not(:disabled) {
    background-color: var(--color-text);
    color: var(--color-surface);
    border-color: var(--color-text);
  }
  
  .shop-carousel__arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  
  .shop-carousel__wrapper {
    position: relative;
    overflow: hidden;
  }
  
  .shop-carousel__track {
    display: flex;
    gap: var(--spacing-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }
  
  .shop-carousel__track::-webkit-scrollbar {
    display: none;
  }
  
  .shop-carousel__item {
    flex: 0 0 85%;
    scroll-snap-align: start;
  }
  
  @media (min-width: 768px) {
    .shop-carousel__item {
      flex: 0 0 45%;
    }
  }
  
  @media (min-width: 1024px) {
    .shop-carousel__item {
      flex: 0 0 32%;
    }
  }
  
  .product-card--shop {
    position: relative;
  }
  
  .product-card--shop .card__image-wrapper {
    aspect-ratio: 1;
  }
</style>

<section class="shop-carousel">
  <div class="container">
    <div class="shop-carousel__controls">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 style="font-size: var(--font-size-h1); margin-bottom: var(--spacing-3);">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.enable_filters -%}
          <div class="filter-pills" style="margin-bottom: 0; margin-top: var(--spacing-3);">
            <button type="button" class="filter-pill active" data-filter="all" aria-pressed="true">All</button>
            {%- for block in section.blocks -%}
              {%- if block.type == 'filter' -%}
                <button type="button" class="filter-pill" data-filter="{{ block.settings.category | handleize }}" aria-pressed="false" {{ block.shopify_attributes }}>
                  {{ block.settings.category }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      
      <div class="shop-carousel__arrows">
        <button type="button" class="shop-carousel__arrow" data-carousel-prev aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.5 15L7.5 10l5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="shop-carousel__arrow" data-carousel-next aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 15l5-5-5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
    
    <div class="shop-carousel__wrapper">
      <div class="shop-carousel__track" data-carousel-track>
        {%- liquid
          assign collection = collections[section.settings.collection]
          assign products_to_show = section.settings.products_to_show | default: 6
          
          if collection != blank and collection.products.size > 0
            for product in collection.products limit: products_to_show
              render 'product-card-shop', product: product, index: forloop.index
            endfor
          else
            for i in (1..products_to_show)
              render 'product-card-shop', product: blank, demo: true, index: i
            endfor
          endif
        -%}
      </div>
    </div>
    
    {%- if section.settings.view_all_label != blank -%}
      <div style="text-align: center; margin-top: var(--spacing-8);">
        <a href="{{ section.settings.view_all_link }}" class="button button--secondary">
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function() {
    const track = document.querySelector('[data-carousel-track]');
    const prevBtn = document.querySelector('[data-carousel-prev]');
    const nextBtn = document.querySelector('[data-carousel-next]');
    
    if (!track || !prevBtn || !nextBtn) return;
    
    function updateButtons() {
      const isAtStart = track.scrollLeft <= 0;
      const isAtEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 10;
      
      prevBtn.disabled = isAtStart;
      nextBtn.disabled = isAtEnd;
    }
    
    prevBtn.addEventListener('click', function() {
      track.scrollBy({ left: -track.clientWidth * 0.8, behavior: 'smooth' });
    });
    
    nextBtn.addEventListener('click', function() {
      track.scrollBy({ left: track.clientWidth * 0.8, behavior: 'smooth' });
    });
    
    track.addEventListener('scroll', updateButtons);
    updateButtons();
    
    const filters = document.querySelectorAll('.filter-pill');
    filters.forEach(function(filter) {
      filter.addEventListener('click', function() {
        const category = this.getAttribute('data-filter');
        
        filters.forEach(f => {
          f.classList.remove('active');
          f.setAttribute('aria-pressed', 'false');
        });
        
        this.classList.add('active');
        this.setAttribute('aria-pressed', 'true');
        
        const cards = track.querySelectorAll('.product-card--shop');
        cards.forEach(function(card) {
          const cardCategory = card.getAttribute('data-category');
          
          if (category === 'all' || cardCategory === category) {
            card.style.display = '';
            card.removeAttribute('aria-hidden');
          } else {
            card.style.display = 'none';
            card.setAttribute('aria-hidden', 'true');
          }
        });
        
        updateButtons();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Shop Carousel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best-sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Enable Filters",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Button Link"
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Category Name",
          "default": "Cleansers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Carousel",
      "blocks": [
        {
          "type": "filter",
          "settings": {
            "category": "Cleansers"
          }
        },
        {
          "type": "filter",
          "settings": {
            "category": "Serums"
          }
        },
        {
          "type": "filter",
          "settings": {
            "category": "Moisturizers"
          }
        },
        {
          "type": "filter",
          "settings": {
            "category": "SPF"
          }
        }
      ]
    }
  ]
}
{% endschema %}
