{%- comment -%}
  Before/After slider section
{%- endcomment -%}

<style>
  .before-after-section {
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
    background-color: var(--color-surface);
  }
  
  .before-after-section__slider {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .before-after-section__container {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-beige);
  }
  
  .before-after-section__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .before-after-section__after {
    clip-path: inset(0 50% 0 0);
  }
  
  .before-after-section__divider {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--color-surface);
    transform: translateX(-50%);
    z-index: 2;
  }
  
  .before-after-section__handle {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-surface);
    box-shadow: 0 4px 12px rgba(21, 21, 21, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    cursor: ew-resize;
    z-index: 3;
  }
  
  .before-after-section__handle svg {
    width: 24px;
    height: 24px;
    color: var(--color-text);
  }
  
  .before-after-section__labels {
    position: absolute;
    top: var(--spacing-3);
    left: var(--spacing-3);
    right: var(--spacing-3);
    display: flex;
    justify-content: space-between;
    z-index: 1;
  }
  
  .before-after-section__label {
    padding: var(--spacing-1) var(--spacing-2);
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-body-sm);
    font-weight: 600;
    color: var(--color-text);
  }
  
  .before-after-section__info {
    text-align: center;
    margin-top: var(--spacing-6);
  }
  
  .before-after-section__treatment {
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-2);
  }
  
  .before-after-section__result {
    font-size: var(--font-size-h3);
    font-weight: 600;
  }
</style>

<section class="before-after-section">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow section-header__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="before-after-section__slider">
      <div class="before-after-section__container" data-before-after>
        {%- if section.settings.before_image != blank -%}
          <img 
            src="{{ section.settings.before_image | image_url: width: 1200 }}"
            srcset="{{ section.settings.before_image | image_url: width: 800 }} 800w,
                    {{ section.settings.before_image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 800px) 800px, 100vw"
            alt="Before"
            class="before-after-section__image before-after-section__before"
            loading="lazy"
          >
        {%- endif -%}
        
        {%- if section.settings.after_image != blank -%}
          <img 
            src="{{ section.settings.after_image | image_url: width: 1200 }}"
            srcset="{{ section.settings.after_image | image_url: width: 800 }} 800w,
                    {{ section.settings.after_image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 800px) 800px, 100vw"
            alt="After"
            class="before-after-section__image before-after-section__after"
            loading="lazy"
            data-after-image
          >
        {%- endif -%}
        
        <div class="before-after-section__divider" data-divider></div>
        
        <div class="before-after-section__handle" data-handle>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        
        <div class="before-after-section__labels">
          <span class="before-after-section__label">Before</span>
          <span class="before-after-section__label">After</span>
        </div>
      </div>
      
      {%- if section.settings.treatment != blank or section.settings.result != blank -%}
        <div class="before-after-section__info">
          {%- if section.settings.treatment != blank -%}
            <div class="before-after-section__treatment">{{ section.settings.treatment }}</div>
          {%- endif -%}
          {%- if section.settings.result != blank -%}
            <div class="before-after-section__result">{{ section.settings.result }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function() {
    const container = document.querySelector('[data-before-after]');
    if (!container) return;
    
    const afterImage = container.querySelector('[data-after-image]');
    const divider = container.querySelector('[data-divider]');
    const handle = container.querySelector('[data-handle]');
    
    let isDragging = false;
    
    function updatePosition(x) {
      const rect = container.getBoundingClientRect();
      const position = Math.max(0, Math.min(1, (x - rect.left) / rect.width));
      const percentage = position * 100;
      
      afterImage.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
      divider.style.left = `${percentage}%`;
      handle.style.left = `${percentage}%`;
    }
    
    function onMove(e) {
      if (!isDragging) return;
      e.preventDefault();
      const x = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      updatePosition(x);
    }
    
    function onStart(e) {
      isDragging = true;
      const x = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      updatePosition(x);
    }
    
    function onEnd() {
      isDragging = false;
    }
    
    handle.addEventListener('mousedown', onStart);
    handle.addEventListener('touchstart', onStart);
    
    document.addEventListener('mousemove', onMove);
    document.addEventListener('touchmove', onMove);
    
    document.addEventListener('mouseup', onEnd);
    document.addEventListener('touchend', onEnd);
    
    container.addEventListener('click', function(e) {
      if (e.target !== handle) {
        updatePosition(e.clientX);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Before/After Slider",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real results from real clients"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "text",
      "id": "treatment",
      "label": "Treatment Name",
      "default": "Hydrafacial + Microneedling"
    },
    {
      "type": "text",
      "id": "result",
      "label": "Result Description",
      "default": "Smoother texture and refined pores after 3 sessions"
    }
  ],
  "presets": [
    {
      "name": "Before/After Slider"
    }
  ]
}
{% endschema %}
