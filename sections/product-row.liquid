{%- comment -%}
  Product Row - Display retail products
{%- endcomment -%}

<style>
  .product-row {
    background-color: var(--color-bg);
  }
  
  .product-row__header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }
  
  .product-row__heading {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-md);
  }
  
  .product-row__subheading {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
  }
  
  .product-row__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }
  
  @media (min-width: 768px) {
    .product-row__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .product-row__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  .product-card {
    display: flex;
    flex-direction: column;
  }
  
  .product-card__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: var(--spacing-md);
  }
  
  .product-card__title {
    font-size: var(--font-size-base);
    margin-bottom: var(--spacing-sm);
  }
  
  .product-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  
  .product-card__title a:hover {
    color: var(--color-accent);
  }
  
  .product-card__price {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
  }
</style>

<section class="product-row section">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="product-row__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="product-row__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subheading != blank -%}
          <p class="product-row__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="product-row__grid">
      {%- if section.settings.collection != blank -%}
        {%- assign products = collections[section.settings.collection].products -%}
        {%- assign limit = section.settings.products_to_show | default: 4 -%}
        
        {%- for product in products limit: limit -%}
          <article class="card product-card">
            <a href="{{ product.url }}">
              {%- if product.featured_image != blank -%}
                <img
                  srcset="
                    {{ product.featured_image | image_url: width: 300 }} 300w,
                    {{ product.featured_image | image_url: width: 400 }} 400w,
                    {{ product.featured_image | image_url: width: 600 }} 600w
                  "
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 100vw"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="product-card__image"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              {%- else -%}
                {%- assign product_num = forloop.index | default: 1 | modulo: 6 | plus: 1 -%}
                {%- assign fallback_file = 'mc-product-0' | append: product_num | append: '.jpg' -%}
                <img
                  src="{{ fallback_file | asset_url }}"
                  alt="{{ product.title | escape }}, Maison Calla concept"
                  class="product-card__image"
                  width="1600"
                  height="1600"
                  loading="lazy"
                >
              {%- endif -%}
            </a>
            
            <h3 class="product-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            
            <div class="product-card__price">
              {%- if product.price_varies -%}
                From {{ product.price_min | money }}
              {%- else -%}
                {{ product.price | money }}
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {%- assign product_num = i | modulo: 6 | plus: 1 -%}
          {%- assign fallback_file = 'mc-product-0' | append: product_num | append: '.jpg' -%}
          <article class="card product-card">
            <img
              src="{{ fallback_file | asset_url }}"
              alt="Product {{ i }}, Maison Calla concept"
              class="product-card__image"
              width="1600"
              height="1600"
              loading="lazy"
            >
            <h3 class="product-card__title">Product {{ i }}</h3>
            <div class="product-card__price">$45.00</div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
    
    {%- if section.settings.view_all_link != blank -%}
      <div style="text-align: center; margin-top: var(--spacing-xl);">
        <a href="{{ section.settings.view_all_link }}" class="button">
          {{ section.settings.view_all_label | default: 'Shop All' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Row",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Retail"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Professional-grade skincare and products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Button Link"
    }
  ],
  "presets": [
    {
      "name": "Product Row"
    }
  ]
}
{% endschema %}
