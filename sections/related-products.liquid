{%- comment -%}
  Related Products / Treatments
{%- endcomment -%}

<style>
  .related-products {
    background-color: var(--color-bg-secondary);
  }
  
  .related-products__heading {
    text-align: center;
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-2xl);
  }
</style>

<section class="related-products section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="related-products__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    
    {%- liquid
      assign limit = section.settings.products_to_show | default: 3
      assign recommendations = recommendations | default: null
    -%}
    
    <div class="grid grid--3-col" id="related-products-{{ section.id }}">
      {%- if recommendations != null and recommendations.products.size > 0 -%}
        {%- for product in recommendations.products limit: limit -%}
          {% render 'treatment-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Fallback to same collection {%- endcomment -%}
        {%- if product.collections.size > 0 -%}
          {%- assign collection = product.collections.first -%}
          {%- for related_product in collection.products limit: limit -%}
            {%- unless related_product.id == product.id -%}
              {% render 'treatment-card', product: related_product %}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  // Request product recommendations
  fetch(window.Shopify.routes.root + 'recommendations/products.json?product_id={{ product.id }}&limit={{ limit }}&section_id={{ section.id }}')
    .then(response => response.json())
    .then(data => {
      if (data.products && data.products.length > 0) {
        // Recommendations loaded, they'll appear via liquid
        console.log('Product recommendations loaded');
      }
    })
    .catch(error => {
      console.error('Error loading recommendations:', error);
    });
</script>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of Products",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
