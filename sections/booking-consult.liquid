{%- comment -%}
  Booking Consult Section
  Promotes free 15-minute consultation with video/in-studio toggle
{%- endcomment -%}

<style>
  .booking-consult {
    padding-top: var(--spacing-15);
    padding-bottom: var(--spacing-4xl);
  }
  
  .consult-cards {
    display: flex;
    gap: 24px;
  }
  
  @media (max-width: 768px) {
    .consult-cards {
      flex-direction: column;
    }
  }
  
  .consult-card--left {
    flex: 1;
    padding: 40px;
    background-color: var(--color-sage-soft);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  
  .consult-card--right {
    flex: 1;
    padding: 40px 32px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  
  .consult-card__eyebrow {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--font-size-eyebrow);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--color-text-muted);
  }
  
  .consult-card__eyebrow::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-sage);
  }
  
  .consult-card__heading {
    font-size: var(--font-size-h1);
    line-height: 50px;
    letter-spacing: -1.32px;
    font-weight: 600;
    margin: 0;
  }
  
  .consult-card__description {
    font-size: 18px;
    line-height: 28px;
    color: var(--color-text-muted);
    margin: 0;
  }
  
  .consult-card__format-label {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 12px;
  }
  
  .consult-toggle {
    display: flex;
    gap: 2px;
    padding: 4px;
    background-color: var(--color-subtle-surface);
    border-radius: var(--radius-pill);
  }
  
  .consult-toggle__option {
    flex: 1;
    padding: 8px 16px;
    border: none;
    border-radius: var(--radius-pill);
    background-color: transparent;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .consult-toggle__option[aria-pressed="true"] {
    background-color: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
  }
  
  .consult-card__chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  
  .consult-card__chip {
    padding: 7px 12px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 500;
  }
  
  .consult-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .consult-step {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  
  .consult-step__number {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-sage-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-sage-deep);
    flex-shrink: 0;
  }
  
  .consult-step__content {
    flex: 1;
    padding-top: 4px;
  }
  
  .consult-step__title {
    font-size: 19px;
    line-height: 26px;
    font-family: var(--font-heading);
    font-weight: 600;
    margin: 0 0 4px 0;
  }
  
  .consult-step__description {
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-muted);
    margin: 0;
  }
  
  .consult-card--right h3 {
    font-size: var(--font-size-h2);
    line-height: 32px;
    letter-spacing: -0.52px;
    margin: 0;
  }
</style>

<div class="booking-consult">
  <div class="container">
    <div class="consult-cards">
      <!-- Left Card -->
      <div class="consult-card--left">
        <div class="consult-card__eyebrow">Not sure where to start?</div>
        <h2 class="consult-card__heading">Free 15-min virtual consultation.</h2>
        <p class="consult-card__description">Talk through your goals with a licensed provider before you book anything. No cost, no obligation, no hard sell.</p>
        
        <div>
          <div class="consult-card__format-label">Choose a format</div>
          <div class="consult-toggle">
            <button 
              type="button" 
              class="consult-toggle__option" 
              data-consult-type="video"
              aria-pressed="true"
            >
              Video call
            </button>
            <button 
              type="button" 
              class="consult-toggle__option" 
              data-consult-type="studio"
              aria-pressed="false"
            >
              In-studio
            </button>
          </div>
        </div>
        
        <div class="consult-card__chips">
          <span class="consult-card__chip">15 minutes</span>
          <span class="consult-card__chip">Free</span>
          <span class="consult-card__chip">Any time zone</span>
        </div>
        
        <a href="{{ section.settings.consult_link | default: '/pages/book' }}" class="button button--primary" data-book-cta data-cta-type="consult">
          Book a free consultation
        </a>
      </div>
      
      <!-- Right Card -->
      <div class="consult-card--right">
        <h3>What happens in a consult</h3>
        
        <div class="consult-steps">
          <div class="consult-step">
            <div class="consult-step__number">1</div>
            <div class="consult-step__content">
              <h4 class="consult-step__title">Tell us your goals</h4>
              <p class="consult-step__description">Share what you want to change and any treatments you have had before.</p>
            </div>
          </div>
          
          <div class="consult-step">
            <div class="consult-step__number">2</div>
            <div class="consult-step__content">
              <h4 class="consult-step__title">Quick skin review</h4>
              <p class="consult-step__description">Your provider looks at your skin on video and flags what is realistic.</p>
            </div>
          </div>
          
          <div class="consult-step">
            <div class="consult-step__number">3</div>
            <div class="consult-step__content">
              <h4 class="consult-step__title">A plan, no pressure</h4>
              <p class="consult-step__description">Leave with a suggested treatment plan, pricing and a time to book if you like.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Booking Consult",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure where to start?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Book a free 15-minute consultation"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Connect with one of our licensed providers to discuss your skin goals and get personalized treatment recommendations."
    },
    {
      "type": "text",
      "id": "step_1_title",
      "label": "Step 1 Title",
      "default": "Book your time"
    },
    {
      "type": "text",
      "id": "step_1_description",
      "label": "Step 1 Description",
      "default": "Choose a convenient 15-minute slot"
    },
    {
      "type": "text",
      "id": "step_2_title",
      "label": "Step 2 Title",
      "default": "Meet your provider"
    },
    {
      "type": "text",
      "id": "step_2_description",
      "label": "Step 2 Description",
      "default": "Discuss your concerns and goals"
    },
    {
      "type": "text",
      "id": "step_3_title",
      "label": "Step 3 Title",
      "default": "Get recommendations"
    },
    {
      "type": "text",
      "id": "step_3_description",
      "label": "Step 3 Description",
      "default": "Receive a personalized treatment plan"
    },
    {
      "type": "url",
      "id": "consult_link",
      "label": "Consultation Link"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Book free consultation"
    }
  ],
  "presets": [
    {
      "name": "Booking Consult"
    }
  ]
}
{% endschema %}
