{%- comment -%}
  Hero section with separate Book and Shop buttons
{%- endcomment -%}

<style>
  .hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-ivory);
  }
  
  .hero__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  
  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(42, 42, 42, 0.3), rgba(42, 42, 42, 0.5));
    z-index: 0;
  }
  
  .hero__content {
    position: relative;
    z-index: 1;
    padding: var(--spacing-xl);
    max-width: 800px;
  }
  
  .hero__heading {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-lg);
    color: var(--color-ivory);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
  }
  
  @media (max-width: 767px) {
    .hero__heading {
      font-size: calc(var(--font-size-2xl) * 1.2);
    }
  }
  
  .hero__subheading {
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-xl);
    color: rgba(250, 249, 247, 0.95);
    font-weight: 400;
    line-height: 1.5;
  }
  
  .hero__actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .hero__button {
    min-width: 200px;
    background-color: var(--color-ivory);
    border-color: var(--color-ivory);
    color: var(--color-soft-black);
    font-weight: 600;
  }
  
  .hero__button:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-ivory);
  }
  
  .hero__button--primary {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-ivory);
  }
  
  .hero__button--primary:hover {
    background-color: var(--color-ivory);
    border-color: var(--color-ivory);
    color: var(--color-soft-black);
  }
</style>

<section class="hero section">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 1600 }}"
      srcset="
        {{ section.settings.image | image_url: width: 400 }} 400w,
        {{ section.settings.image | image_url: width: 800 }} 800w,
        {{ section.settings.image | image_url: width: 1200 }} 1200w,
        {{ section.settings.image | image_url: width: 1600 }} 1600w
      "
      sizes="100vw"
      alt="{{ section.settings.heading | escape }}"
      class="hero__image"
      loading="eager"
      fetchpriority="high"
      width="1600"
      height="900"
    >
  {%- else -%}
    <div class="hero__image" style="background-color: #F5EFE6;">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}
  
  <div class="hero__overlay"></div>
  
  <div class="hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    
    <div class="hero__actions">
      {%- liquid
        assign book_link = section.settings.book_link
        if book_link == blank and settings.booking_page != blank
          assign book_link = pages[settings.booking_page].url
        endif
        
        assign shop_link = section.settings.shop_link
        if shop_link == blank
          assign shop_link = '/collections/all'
        endif
      -%}
      
      <a 
        href="{{ book_link | default: '#book' }}" 
        class="button hero__button hero__button--primary"
        data-book-cta
        data-cta-type="book"
      >
        {{ section.settings.book_label | default: 'Book Treatment' }}
      </a>
      
      <a 
        href="{{ shop_link }}" 
        class="button hero__button"
      >
        {{ section.settings.shop_label | default: 'Shop Retail' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinical Excellence, Luxurious Care"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Experience transformative treatments in our serene med spa"
    },
    {
      "type": "text",
      "id": "book_label",
      "label": "Book Button Label",
      "default": "Book Treatment"
    },
    {
      "type": "url",
      "id": "book_link",
      "label": "Book Button Link"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop Button Label",
      "default": "Shop Retail"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
