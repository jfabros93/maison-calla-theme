{%- comment -%}
  Main Contact - Contact and service area page
{%- endcomment -%}

<style>
  .contact-page {
    padding: var(--section-spacing) 0;
  }
  
  .contact-page__grid {
    display: grid;
    gap: var(--spacing-2xl);
  }
  
  @media (min-width: 768px) {
    .contact-page__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  .contact-page__title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-md);
  }
  
  .contact-page__description {
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: var(--spacing-xl);
  }
  
  .contact-page__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  
  .contact-page__detail {
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-stone);
  }
  
  .contact-page__detail:last-child {
    border-bottom: none;
  }
  
  .contact-page__detail-title {
    font-size: var(--font-size-base);
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .contact-page__detail-content {
    color: var(--color-text-light);
    line-height: 1.6;
  }
  
  .contact-page__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--font-size-lg);
  }
  
  .contact-page__phone:hover {
    color: var(--color-accent);
  }
  
  .contact-page__email {
    color: var(--color-text);
    text-decoration: none;
  }
  
  .contact-page__email:hover {
    color: var(--color-accent);
  }
  
  .contact-page__form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  
  .contact-page__form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
  
  .contact-page__label {
    font-weight: 600;
  }
  
  .contact-page__input,
  .contact-page__textarea {
    min-height: var(--tap-target-min);
    padding: var(--spacing-sm) var(--spacing-md);
    border: 2px solid var(--color-stone);
    background-color: var(--color-bg);
    font-family: var(--font-body);
    font-size: var(--font-size-base);
  }
  
  .contact-page__textarea {
    min-height: 150px;
    resize: vertical;
  }
  
  .contact-page__service-areas {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-2xl);
    border-top: 1px solid var(--color-stone);
  }
  
  .contact-page__service-areas-title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-lg);
    text-align: center;
  }
  
  .contact-page__service-areas-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-sm);
  }
  
  @media (min-width: 768px) {
    .contact-page__service-areas-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  .contact-page__service-area {
    color: var(--color-text-light);
    font-size: var(--font-size-sm);
    text-align: center;
    padding: var(--spacing-sm);
  }
</style>

<div class="contact-page">
  <div class="container">
    <h1 class="contact-page__title">{{ page.title }}</h1>
    
    {%- if page.content != blank -%}
      <div class="contact-page__description rte">
        {{ page.content }}
      </div>
    {%- endif -%}
    
    <div class="contact-page__grid">
      <div class="contact-page__info">
        {%- if section.settings.phone != blank -%}
          <div class="contact-page__detail">
            <div class="contact-page__detail-title">Phone</div>
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" class="contact-page__phone">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              {{ section.settings.phone }}
            </a>
          </div>
        {%- endif -%}
        
        {%- if section.settings.email != blank -%}
          <div class="contact-page__detail">
            <div class="contact-page__detail-title">Email</div>
            <a href="mailto:{{ section.settings.email }}" class="contact-page__email">
              {{ section.settings.email }}
            </a>
          </div>
        {%- endif -%}
        
        {%- if section.settings.hours != blank -%}
          <div class="contact-page__detail">
            <div class="contact-page__detail-title">Hours</div>
            <div class="contact-page__detail-content">
              {{ section.settings.hours | newline_to_br }}
            </div>
          </div>
        {%- endif -%}
        
        {%- if section.settings.address != blank -%}
          <div class="contact-page__detail">
            <div class="contact-page__detail-title">Address</div>
            <address class="contact-page__detail-content">
              {{ section.settings.address | newline_to_br }}
            </address>
          </div>
        {%- endif -%}
      </div>
      
      <div>
        <form class="contact-page__form" method="post" action="/contact#contact_form" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="contact">
          <input type="hidden" name="utf8" value="✓">
          
          <div class="contact-page__form-group">
            <label class="contact-page__label" for="contact-name">
              {{ 'contact.form.name' | t }}
            </label>
            <input
              type="text"
              id="contact-name"
              name="contact[name]"
              class="contact-page__input"
              required
            >
          </div>
          
          <div class="contact-page__form-group">
            <label class="contact-page__label" for="contact-email">
              {{ 'contact.form.email' | t }}
            </label>
            <input
              type="email"
              id="contact-email"
              name="contact[email]"
              class="contact-page__input"
              required
            >
          </div>
          
          <div class="contact-page__form-group">
            <label class="contact-page__label" for="contact-phone">
              {{ 'contact.form.phone' | t }}
            </label>
            <input
              type="tel"
              id="contact-phone"
              name="contact[phone]"
              class="contact-page__input"
            >
          </div>
          
          <div class="contact-page__form-group">
            <label class="contact-page__label" for="contact-message">
              {{ 'contact.form.message' | t }}
            </label>
            <textarea
              id="contact-message"
              name="contact[body]"
              class="contact-page__textarea"
              required
            ></textarea>
          </div>
          
          <button type="submit" class="button button--primary">
            {{ 'contact.form.send' | t }}
          </button>
        </form>
      </div>
    </div>
    
    {%- if section.settings.service_areas != blank -%}
      <div class="contact-page__service-areas">
        <h2 class="contact-page__service-areas-title">We Serve These Areas</h2>
        
        <div class="contact-page__service-areas-grid">
          {%- assign areas_list = section.settings.service_areas | newline_to_br | split: '<br />' -%}
          {%- for area in areas_list -%}
            {%- assign area_text = area | strip -%}
            {%- if area_text != blank -%}
              <div class="contact-page__service-area">{{ area_text }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "(555) 123-4567"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "hello@maisoncalla.com"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Hours (one per line)",
      "default": "Monday - Friday: 9am - 7pm\nSaturday: 10am - 5pm\nSunday: Closed"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "123 Wellness Avenue\nSuite 200\nSan Francisco, CA 94102"
    },
    {
      "type": "textarea",
      "id": "service_areas",
      "label": "Service Areas (one per line)",
      "default": "San Francisco\nMarin County\nOakland\nBerkeley\nSan Mateo\nPalo Alto\nSaratoga\nLos Gatos"
    }
  ]
}
{% endschema %}
