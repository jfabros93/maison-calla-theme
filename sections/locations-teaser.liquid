{%- comment -%}
  Locations teaser section with intro and studio cards
{%- endcomment -%}

<style>
  .locations-teaser {
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
  }
  
  .locations-teaser__grid {
    display: grid;
    gap: var(--spacing-6);
    grid-template-columns: 1fr;
  }
  
  @media (min-width: 1024px) {
    .locations-teaser__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  
  .locations-teaser__intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--spacing-6);
  }
  
  @media (min-width: 1024px) {
    .locations-teaser__intro {
      padding: var(--spacing-8);
    }
  }
  
  .locations-teaser__intro-eyebrow {
    margin-bottom: var(--spacing-3);
  }
  
  .locations-teaser__intro-title {
    font-size: var(--font-size-h1);
    margin-bottom: var(--spacing-4);
  }
  
  .locations-teaser__intro-text {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--spacing-5);
  }
  
  .location-card__image-wrapper {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    overflow: hidden;
    background-color: var(--color-beige);
  }
  
  .location-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<section class="locations-teaser">
  <div class="container">
    <div class="locations-teaser__grid">
      <div class="locations-teaser__intro">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow locations-teaser__intro-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        
        {%- if section.settings.heading != blank -%}
          <h2 class="locations-teaser__intro-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.text != blank -%}
          <p class="locations-teaser__intro-text">{{ section.settings.text }}</p>
        {%- endif -%}
        
        {%- if section.settings.button_label != blank -%}
          <div>
            <a href="{{ section.settings.button_link }}" class="button button--primary">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
      
      {%- for block in section.blocks -%}
        {%- if block.type == 'location' -%}
          <div class="location-card card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="location-card__image-wrapper">
                <img 
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                          {{ block.settings.image | image_url: width: 600 }} 600w"
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt="{{ block.settings.name | escape }}"
                  class="location-card__image"
                  loading="lazy"
                >
              </div>
            {%- endif -%}
            
            <div class="location-card card__content">
              {%- if block.settings.name != blank -%}
                <h3 class="location-card__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              
              {%- if block.settings.address != blank -%}
                <div class="location-card__address">{{ block.settings.address }}</div>
              {%- endif -%}
              
              {%- if block.settings.link_label != blank -%}
                <a href="{{ block.settings.link_url }}" class="location-card__link">
                  {{ block.settings.link_label }}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-left: 4px;">
                    <path d="M6 12l4-4-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Locations Teaser",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Locations"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit us"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Three studios across the Bay Area, each designed for your comfort and relaxation."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View all locations"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "San Francisco"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "123 Market Street\nSan Francisco, CA 94103"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Get directions"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Locations Teaser",
      "blocks": [
        {
          "type": "location",
          "settings": {
            "name": "San Francisco",
            "address": "123 Market Street\nSan Francisco, CA 94103",
            "link_label": "Get directions"
          }
        },
        {
          "type": "location",
          "settings": {
            "name": "Oakland",
            "address": "456 Broadway\nOakland, CA 94612",
            "link_label": "Get directions"
          }
        }
      ]
    }
  ]
}
{% endschema %}
