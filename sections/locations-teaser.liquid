{%- comment -%}
  Locations teaser section with intro and studio cards
{%- endcomment -%}

<style>
  .locations-teaser {
    padding-top: 120px;
  }
  
  .locations-teaser__grid {
    display: grid;
    gap: 24px;
    grid-template-columns: 1fr;
    align-items: stretch;
  }
  
  @media (min-width: 1024px) {
    .locations-teaser__grid {
      grid-template-columns: 520px 1fr 1fr;
    }
  }
  
  .locations-teaser__intro {
    background: var(--color-sage-soft);
    border-radius: var(--radius-xl);
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  
  .locations-teaser__intro-header {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  
  .locations-teaser__intro-header::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-text);
    flex-shrink: 0;
  }
  
  .locations-teaser__intro-eyebrow {
    font-size: 12px;
    line-height: 16px;
    font-weight: 500;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-text);
  }
  
  .locations-teaser__intro-title {
    font-size: 44px;
    line-height: 50px;
    letter-spacing: -1.32px;
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
  }
  
  .locations-teaser__intro-text {
    font-size: 18px;
    line-height: 28px;
    color: var(--color-text-muted);
    margin: 0;
  }
  
  .location-card {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 8px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  
  .location-card__media {
    height: 180px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-stone);
    position: relative;
    margin-bottom: 10px;
  }
  
  .location-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .location-card__hours {
    position: absolute;
    bottom: 12px;
    left: 12px;
    padding: 6px 12px;
    background-color: rgba(255, 255, 255, 0.85);
    border-radius: var(--radius-pill);
    font-size: 13px;
    line-height: 16px;
    font-weight: 500;
    color: var(--color-text);
  }
  
  .location-card__body {
    padding: 18px 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .location-card__name {
    font-size: 19px;
    line-height: 26px;
    letter-spacing: -0.19px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }
  
  .location-card__address-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  
  .location-card__address-row svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-text-muted);
  }
  
  .location-card__address {
    font-size: 14px;
    line-height: 20px;
    color: var(--color-text-muted);
    margin: 0;
  }
  
  .location-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
  }
  
  .location-card__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
    letter-spacing: -0.075px;
    color: var(--color-text);
    text-decoration: none;
  }
  
  .location-card__link:hover {
    color: var(--color-sage);
  }
  
  .location-card__arrow {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background-color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .location-card__arrow svg {
    width: 18px;
    height: 18px;
    stroke: var(--color-surface);
  }
</style>

<section class="locations-teaser">
  <div class="container">
    <div class="locations-teaser__grid">
      <div class="locations-teaser__intro">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <div class="locations-teaser__intro-header">
              <div class="locations-teaser__intro-eyebrow">{{ section.settings.eyebrow }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.heading != blank -%}
            <h2 class="locations-teaser__intro-title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          
          {%- if section.settings.text != blank -%}
            <p class="locations-teaser__intro-text">{{ section.settings.text }}</p>
          {%- endif -%}
        </div>
        
        {%- if section.settings.button_label != blank -%}
          <div>
            <a href="{{ section.settings.button_link }}" class="button button--primary">
              {{ section.settings.button_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
      
      {%- for block in section.blocks -%}
        {%- if block.type == 'location' -%}
          <div class="location-card" {{ block.shopify_attributes }}>
            <div class="location-card__media">
              {%- if block.settings.image != blank -%}
                <img 
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                          {{ block.settings.image | image_url: width: 600 }} 600w"
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt="{{ block.settings.name | escape }}"
                  class="location-card__image"
                  width="{{ block.settings.image.width | default: 600 }}"
                  height="{{ block.settings.image.height | default: 180 }}"
                  loading="lazy"
                >
              {%- else -%}
                {%- assign loc_num = forloop.index | default: 1 | modulo: 3 | plus: 1 -%}
                {%- assign fallback_file = 'mc-location-0' | append: loc_num | append: '.jpg' -%}
                <img
                  src="{{ fallback_file | asset_url }}"
                  alt="{{ block.settings.name | default: 'Location' | escape }}, Maison Calla concept"
                  class="location-card__image"
                  width="1920"
                  height="1080"
                  loading="lazy"
                >
              {%- endif -%}
              {%- if block.settings.hours != blank -%}
                <div class="location-card__hours">{{ block.settings.hours }}</div>
              {%- endif -%}
            </div>
            
            <div class="location-card__body">
              {%- if block.settings.name != blank -%}
                <h3 class="location-card__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              
              {%- if block.settings.address != blank -%}
                <div class="location-card__address-row">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 14s6-5.686 6-9A6 6 0 002 5c0 3.314 6 9 6 9z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="8" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                  <div class="location-card__address">{{ block.settings.address | newline_to_br }}</div>
                </div>
              {%- endif -%}
              
              <div class="location-card__footer">
                {%- if block.settings.link_label != blank -%}
                  <a href="{{ block.settings.link_url }}" class="location-card__link">
                    {{ block.settings.link_label }}
                  </a>
                  <div class="location-card__arrow">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M5.25 12.75L12.75 5.25M12.75 5.25H5.25M12.75 5.25V12.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Locations Teaser",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Locations"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three calm studios across the Bay."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Free parking, evening hours and same-week appointments at every studio."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "View all locations"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "Location",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "San Francisco"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "123 Market Street\nSan Francisco, CA 94103"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Hours",
          "default": "Open today · 9–7"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link Label",
          "default": "Get directions"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Locations Teaser",
      "blocks": [
        {
          "type": "location",
          "settings": {
            "name": "San Francisco",
            "address": "123 Market Street\nSan Francisco, CA 94103",
            "link_label": "Get directions"
          }
        },
        {
          "type": "location",
          "settings": {
            "name": "Oakland",
            "address": "456 Broadway\nOakland, CA 94612",
            "link_label": "Get directions"
          }
        }
      ]
    }
  ]
}
{% endschema %}
