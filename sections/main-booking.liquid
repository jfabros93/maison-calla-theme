{%- comment -%}
  Main Booking Section - Multi-step booking flow
  Steps: Treatment > Provider & Location > Date & Time > Your Details > Confirm
{%- endcomment -%}

<style>
  .booking-container {
    padding: var(--spacing-4xl) 0;
  }
  
  .booking-header {
    margin-bottom: var(--spacing-3xl);
  }
  
  .booking-header__title {
    font-size: 44px;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: var(--spacing-md);
  }
  
  @media (max-width: 767px) {
    .booking-header__title {
      font-size: 30px;
    }
  }
  
  /* Stepper */
  .booking-stepper {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-4xl);
  }
  
  .stepper__step {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .stepper__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 2px solid var(--color-line);
    border-radius: 50%;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }
  
  .stepper__label {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-muted);
  }
  
  .stepper__step[data-status="done"] .stepper__number {
    background-color: var(--color-sage);
    border-color: var(--color-sage);
    color: transparent;
  }
  
  .stepper__step[data-status="done"] .stepper__number:after {
    content: '✓';
    position: absolute;
    color: var(--color-surface);
    font-size: 20px;
  }
  
  .stepper__step[data-status="active"] .stepper__number {
    background-color: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-surface);
  }
  
  .stepper__step[data-status="active"] .stepper__label {
    color: var(--color-text);
    font-weight: 600;
  }
  
  @media (max-width: 767px) {
    .booking-stepper {
      display: none;
    }
  }
  
  /* Mobile Progress Bar */
  .mobile-progress-bar {
    display: none;
    position: sticky;
    top: 60px;
    z-index: 10;
    background-color: var(--color-surface);
    padding: 12px 0;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: var(--spacing-lg);
  }
  
  .mobile-progress-bar__content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .mobile-progress-bar__text {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text);
  }
  
  .mobile-progress-bar__track {
    width: 100%;
    height: 4px;
    background-color: var(--color-line);
    border-radius: 2px;
    overflow: hidden;
  }
  
  .mobile-progress-bar__fill {
    height: 100%;
    background-color: var(--color-sage);
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  @media (max-width: 767px) {
    .mobile-progress-bar {
      display: block;
    }
  }
  
  /* Main Layout */
  .booking-layout {
    display: grid;
    gap: var(--spacing-3xl);
  }
  
  @media (min-width: 1024px) {
    .booking-layout {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }
  
  /* Step Panels */
  .booking-steps {
    min-height: 500px;
  }
  
  .booking-step-panel {
    display: none;
  }
  
  .booking-step-panel.active {
    display: block;
    animation: fadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .step-panel__title {
    font-size: 26px;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
  }
  
  /* Summary Card */
  .booking-summary {
    position: sticky;
    top: 100px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: var(--spacing-lg);
    box-shadow: 0 8px 24px rgba(21, 21, 21, 0.10);
  }
  
  @media (max-width: 1023px) {
    .booking-summary {
      display: none;
    }
  }
  
  .booking-summary__title {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
  }
  
  .booking-summary__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-line);
  }
  
  .summary-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
  }
  
  .summary-row__label {
    font-size: 14px;
    color: var(--color-text-muted);
  }
  
  .summary-row__value {
    font-size: 14px;
    font-weight: 500;
    text-align: right;
  }
  
  .booking-summary__pricing {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: var(--spacing-lg);
  }
  
  .summary-price {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .summary-price__label {
    font-size: 14px;
    color: var(--color-text-muted);
  }
  
  .summary-price__amount {
    font-size: 19px;
    font-weight: 600;
  }
  
  .booking-summary__policy {
    padding: 16px;
    background-color: var(--color-sage-soft);
    border-radius: var(--radius-sm);
    margin-bottom: var(--spacing-lg);
  }
  
  .policy__title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  
  .policy__text {
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  
  .booking-summary__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  /* Mobile Bottom Bar */
  .booking-mobile-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-line);
    padding: 16px;
    box-shadow: 0 -4px 16px rgba(21, 21, 21, 0.08);
  }
  
  @media (max-width: 1023px) {
    .booking-mobile-bar {
      display: block;
    }
  }
  
  .mobile-bar__content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  
  .mobile-bar__info {
    flex: 1;
  }
  
  .mobile-bar__price {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  
  .mobile-bar__details {
    font-size: 13px;
    color: var(--color-text-muted);
  }
  
  .mobile-bar__expand {
    padding: 8px 16px;
    background-color: var(--color-subtle-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  
  /* Mobile Bottom Sheet */
  .booking-mobile-sheet {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    pointer-events: none;
  }
  
  .booking-mobile-sheet.open {
    pointer-events: auto;
  }
  
  .mobile-sheet__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(21, 21, 21, 0.5);
    opacity: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .booking-mobile-sheet.open .mobile-sheet__overlay {
    opacity: 1;
  }
  
  .mobile-sheet__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    max-height: 80vh;
    background-color: var(--color-surface);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding: var(--spacing-lg);
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }
  
  .booking-mobile-sheet.open .mobile-sheet__content {
    transform: translateY(0);
  }
  
  .mobile-sheet__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
  }
  
  .mobile-sheet__title {
    font-size: 19px;
    font-weight: 600;
  }
  
  .mobile-sheet__close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background-color: transparent;
    cursor: pointer;
  }
  
  @media (max-width: 1023px) {
    .booking-mobile-sheet {
      display: block;
    }
  }
</style>

<div class="booking-container">
  <div class="container">
    <!-- Mobile Progress Bar -->
    <div class="mobile-progress-bar">
      <div class="container">
        <div class="mobile-progress-bar__content">
          <span class="mobile-progress-bar__text">Step 1 of 5</span>
          <div class="mobile-progress-bar__track">
            <div class="mobile-progress-bar__fill" style="width: 20%;"></div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Header -->
    <div class="booking-header">
      <h1 class="booking-header__title">{{ section.settings.heading | default: "Book your visit." }}</h1>
      
      <!-- Desktop Stepper -->
      <div class="booking-stepper" role="navigation" aria-label="Booking progress">
        <div class="stepper__step" data-status="active">
          <div class="stepper__number">1</div>
          <span class="stepper__label">{{ section.settings.step_1_label | default: "Treatment" }}</span>
        </div>
        <div class="stepper__step" data-status="todo">
          <div class="stepper__number">2</div>
          <span class="stepper__label">{{ section.settings.step_2_label | default: "Provider & location" }}</span>
        </div>
        <div class="stepper__step" data-status="todo">
          <div class="stepper__number">3</div>
          <span class="stepper__label">{{ section.settings.step_3_label | default: "Date & time" }}</span>
        </div>
        <div class="stepper__step" data-status="todo">
          <div class="stepper__number">4</div>
          <span class="stepper__label">{{ section.settings.step_4_label | default: "Your details" }}</span>
        </div>
        <div class="stepper__step" data-status="todo">
          <div class="stepper__number">5</div>
          <span class="stepper__label">{{ section.settings.step_5_label | default: "Confirm" }}</span>
        </div>
      </div>
    </div>
    
    <!-- Main Layout -->
    <div class="booking-layout">
      <!-- Step Panels -->
      <div class="booking-steps">
        {% render 'booking-step-treatment', section: section %}
        {% render 'booking-step-provider', section: section %}
        {% render 'booking-step-datetime', section: section %}
        {% render 'booking-step-details', section: section %}
        {% render 'booking-step-confirm', section: section %}
      </div>
      
      <!-- Summary Card (Desktop) -->
      <div class="booking-summary">
        <h3 class="booking-summary__title">{{ section.settings.summary_title | default: "Your booking" }}</h3>
        
        <div class="booking-summary__rows">
          <!-- Populated by JavaScript as user selects -->
        </div>
        
        <div class="booking-summary__pricing">
          <div class="summary-price booking-summary__due-today">
            <span class="summary-price__label">{{ section.settings.due_today_label | default: "Due today" }}</span>
            <span class="summary-price__amount">$0</span>
          </div>
          <div class="summary-price booking-summary__due-visit">
            <span class="summary-price__label">{{ section.settings.due_visit_label | default: "Due at visit" }}</span>
            <span class="summary-price__amount">$0</span>
          </div>
        </div>
        
        <div class="booking-summary__policy">
          <div class="policy__title">{{ section.settings.policy_title | default: "Cancellation policy" }}</div>
          <p class="policy__text">{{ section.settings.policy_text | default: "Cancel or reschedule up to 24 hours before your appointment for a full refund." }}</p>
        </div>
        
        <div class="booking-summary__actions">
          <button type="button" class="button button--secondary" data-booking-back>
            {{ section.settings.back_label | default: "Back" }}
          </button>
          <button type="button" class="button" data-booking-continue>
            {{ section.settings.continue_label | default: "Continue" }}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Mobile Bottom Bar -->
<div class="booking-mobile-bar">
  <div class="mobile-bar__content">
    <div class="mobile-bar__info">
      <div class="mobile-bar__price">$50 deposit</div>
      <div class="mobile-bar__details">Select treatment to continue</div>
    </div>
    <button type="button" class="mobile-bar__expand" data-expand-sheet aria-label="View booking summary">
      Summary ↑
    </button>
  </div>
</div>

<!-- Mobile Bottom Sheet -->
<div class="booking-mobile-sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title">
  <div class="mobile-sheet__overlay" data-close-sheet></div>
  <div class="mobile-sheet__content">
    <div class="mobile-sheet__header">
      <h3 class="mobile-sheet__title" id="sheet-title">Your booking</h3>
      <button type="button" class="mobile-sheet__close" data-close-sheet aria-label="Close summary">
        ✕
      </button>
    </div>
    
    <div class="booking-summary__rows">
      <!-- Populated by JavaScript -->
    </div>
    
    <div class="booking-summary__pricing">
      <div class="summary-price booking-summary__due-today">
        <span class="summary-price__label">Due today</span>
        <span class="summary-price__amount">$0</span>
      </div>
      <div class="summary-price booking-summary__due-visit">
        <span class="summary-price__label">Due at visit</span>
        <span class="summary-price__amount">$0</span>
      </div>
    </div>
    
    <div class="booking-summary__policy">
      <div class="policy__title">Cancellation policy</div>
      <p class="policy__text">{{ section.settings.policy_text | default: "Cancel or reschedule up to 24 hours before your appointment for a full refund." }}</p>
    </div>
    
    <div class="booking-summary__actions">
      <button type="button" class="button button--secondary" data-booking-back>Back</button>
      <button type="button" class="button" data-booking-continue>Continue</button>
    </div>
  </div>
</div>

<script src="{{ 'booking.js' | asset_url }}" defer></script>

