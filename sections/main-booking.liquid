{
  "name": "Main Booking",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book your visit."
    },
    {
      "type": "text",
      "id": "step_1_label",
      "label": "Step 1 Label",
