{%- comment -%}
  Team Grid - Display team members with credentials and specialties
{%- endcomment -%}

<style>
  .team-grid {
    background-color: var(--color-bg);
  }
  
  .team-grid__header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }
  
  .team-grid__heading {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-md);
  }
  
  .team-grid__subheading {
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
  }
  
  .team-grid__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
  
  @media (min-width: 768px) {
    .team-grid__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .team-grid__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .team-member {
    background-color: var(--color-bg);
    text-align: center;
    transition: transform var(--transition-speed) var(--transition-easing);
  }
  
  .team-member:hover {
    transform: translateY(-4px);
  }
  
  .team-member__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    margin-bottom: var(--spacing-md);
    overflow: hidden;
    background-color: var(--color-stone);
  }
  
  .team-member__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .team-member__name {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-sm);
  }
  
  .team-member__credentials {
    font-size: var(--font-size-sm);
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  
  .team-member__title {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-md);
  }
  
  .team-member__specialties {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
    line-height: 1.6;
  }
  
  .team-member__cta {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }
</style>

<section class="team-grid section">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="team-grid__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="team-grid__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subheading != blank -%}
          <p class="team-grid__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="team-grid__grid">
      {%- for block in section.blocks -%}
        <article class="team-member" {{ block.shopify_attributes }}>
          <div class="team-member__image-wrapper">
            {%- if block.settings.image != blank -%}
              <img
                srcset="
                  {{ block.settings.image | image_url: width: 300 }} 300w,
                  {{ block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 600 }} 600w
                "
                src="{{ block.settings.image | image_url: width: 400 }}"
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                alt="{{ block.settings.name | escape }}"
                class="team-member__image"
                loading="lazy"
                width="400"
                height="533"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'team-member__image' }}
            {%- endif -%}
          </div>
          
          <h3 class="team-member__name">{{ block.settings.name }}</h3>
          
          {%- if block.settings.credentials != blank -%}
            <div class="team-member__credentials">{{ block.settings.credentials }}</div>
          {%- endif -%}
          
          {%- if block.settings.title != blank -%}
            <div class="team-member__title">{{ block.settings.title }}</div>
          {%- endif -%}
          
          {%- if block.settings.specialties != blank -%}
            <div class="team-member__specialties">
              <strong>Specialties:</strong> {{ block.settings.specialties }}
            </div>
          {%- endif -%}
          
          <div class="team-member__cta">
            {%- if block.settings.page_url != blank -%}
              <a href="{{ block.settings.page_url }}" class="button">View Profile</a>
            {%- endif -%}
            
            <a 
              href="{{ block.settings.book_link | default: '#book' }}" 
              class="button button--primary"
              data-book-cta
              data-cta-type="book"
              data-treatment-name="Appointment with {{ block.settings.name | escape }}"
            >
              Book with {{ block.settings.name | split: ' ' | first }}
            </a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Team Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Our Team"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Board-certified professionals dedicated to your wellness"
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr. Sarah Chen"
        },
        {
          "type": "text",
          "id": "credentials",
          "label": "Credentials",
          "default": "MD, Board Certified Dermatologist"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Medical Director"
        },
        {
          "type": "textarea",
          "id": "specialties",
          "label": "Specialties",
          "default": "Injectable treatments, laser therapy, skin rejuvenation"
        },
        {
          "type": "url",
          "id": "page_url",
          "label": "Profile Page Link"
        },
        {
          "type": "url",
          "id": "book_link",
          "label": "Booking Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Grid",
      "blocks": [
        {
          "type": "team_member",
          "settings": {
            "name": "Dr. Sarah Chen",
            "credentials": "MD, Board Certified",
            "title": "Medical Director",
            "specialties": "Injectable treatments, laser therapy"
          }
        },
        {
          "type": "team_member",
          "settings": {
            "name": "Elena Martinez",
            "credentials": "Licensed Esthetician",
            "title": "Senior Esthetician",
            "specialties": "Facials, chemical peels, microneedling"
          }
        },
        {
          "type": "team_member",
          "settings": {
            "name": "Dr. James Park",
            "credentials": "MD, FAAD",
            "title": "Cosmetic Physician",
            "specialties": "Body contouring, injectables"
          }
        }
      ]
    }
  ]
}
{% endschema %}
