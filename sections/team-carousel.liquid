<style>
  .team-carousel {
    padding: var(--spacing-8) 0;
    background: var(--color-page-bg);
  }
  
  .team-carousel__container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-10);
  }
  
  .team-carousel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-6);
  }
  
  .team-carousel__header-left {
    flex: 1;
  }
  
  .team-carousel__eyebrow {
    font-size: var(--font-size-eyebrow);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-sage-deep);
    margin-bottom: var(--spacing-1);
  }
  
  .team-carousel__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-h1);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  
  .team-carousel__controls {
    display: none;
    gap: var(--spacing-1);
  }
  
  @media (min-width: 1024px) {
    .team-carousel__controls {
      display: flex;
    }
  }
  
  .team-carousel__track {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, 1fr);
    margin-bottom: var(--spacing-3);
  }
  
  @media (min-width: 1024px) {
    .team-carousel__track {
      display: flex;
      gap: var(--spacing-2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    
    .team-carousel__track::-webkit-scrollbar {
      display: none;
    }
  }
  
  .practitioner-card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .practitioner-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  
  .practitioner-card:focus {
    outline: 2px solid var(--color-sage);
    outline-offset: 2px;
  }
  
  @media (min-width: 1024px) {
    .practitioner-card {
      flex: 0 0 280px;
      width: 280px;
    }
  }
  
  .practitioner-card__photo-wrap {
    position: relative;
    width: 100%;
    height: 340px;
    overflow: hidden;
    background: var(--color-stone);
  }
  
  .practitioner-card__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  
  .practitioner-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    padding: var(--spacing-2);
  }
  
  .practitioner-card__name {
    font-family: var(--font-heading);
    font-size: var(--font-size-h3);
    font-weight: 600;
    line-height: 1.37;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  
  .practitioner-card__role {
    font-size: var(--font-size-body-sm);
    line-height: 1.43;
    color: var(--color-text-muted);
  }
  
  .team-carousel__helper {
    font-size: var(--font-size-body-sm);
    line-height: 1.43;
    color: var(--color-text-muted);
    text-align: center;
  }
  
  /* Dialog overlay */
  .team-dialog-overlay {
    position: fixed;
    inset: 0;
    background: rgba(21, 21, 21, 0.4);
    z-index: 9999;
    display: none;
    opacity: 0;
    transition: opacity 0.3s;
  }
  
  .team-dialog-overlay.is-open {
    display: block;
    opacity: 1;
  }
  
  /* Desktop drawer */
  .team-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 480px;
    max-width: 100%;
    background: var(--color-surface);
    border-left: 1px solid var(--color-line);
    transform: translateX(100%);
    transition: transform 0.3s;
    z-index: 10000;
    display: flex;
    flex-direction: column;
  }
  
  .team-drawer.is-open {
    transform: translateX(0);
  }
  
  .team-drawer__top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 16px 16px 20px;
    border-bottom: 1px solid var(--color-line);
    flex-shrink: 0;
  }
  
  .team-drawer__eyebrow {
    font-size: var(--font-size-eyebrow);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-sage-deep);
  }
  
  .team-drawer__photo-wrap {
    width: 100%;
    height: 240px;
    overflow: hidden;
    background: var(--color-stone);
    flex-shrink: 0;
  }
  
  .team-drawer__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  
  .team-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
  }
  
  .team-drawer__content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  
  .team-drawer__name {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    font-weight: 600;
    line-height: 1.23;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  
  .team-drawer__meta {
    font-size: var(--font-size-body-sm);
    line-height: 1.43;
    color: var(--color-text-muted);
  }
  
  .team-drawer__bio {
    font-size: var(--font-size-body);
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--color-text-muted);
  }
  
  .team-drawer__section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .team-drawer__section-title {
    font-size: var(--font-size-eyebrow);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-sage-deep);
  }
  
  .team-drawer__cert-item {
    display: flex;
    gap: 10px;
    font-size: var(--font-size-body-sm);
    line-height: 1.43;
    color: var(--color-text);
  }
  
  .team-drawer__cert-icon {
    flex-shrink: 0;
    color: var(--color-sage);
  }
  
  .team-drawer__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-1);
  }
  
  .team-drawer__time-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-1);
  }
  
  .time-pill {
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.33;
    letter-spacing: -0.005em;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-text);
  }
  
  .time-pill.is-selected {
    background: var(--color-text);
    color: var(--color-surface);
    border-color: var(--color-text);
  }
  
  /* Mobile sheet */
  .team-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: calc(100dvh - 40px);
    background: var(--color-surface);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    transform: translateY(100%);
    transition: transform 0.3s;
    z-index: 10000;
    display: flex;
    flex-direction: column;
  }
  
  .team-sheet.is-open {
    transform: translateY(0);
  }
  
  .team-sheet__handle {
    width: 40px;
    height: 4px;
    background: var(--color-line);
    border-radius: var(--radius-pill);
    margin: 10px auto 6px;
    flex-shrink: 0;
  }
  
  .team-sheet__photo-wrap {
    width: 100%;
    height: 160px;
    overflow: hidden;
    background: var(--color-stone);
    flex-shrink: 0;
  }
  
  .team-sheet__body {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
  }
  
  .team-sheet__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .team-sheet__top-bar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-2);
  }
  
  @media (max-width: 1023px) {
    .team-carousel__container {
      padding: 0 var(--spacing-2);
    }
    
    .team-carousel__heading {
      font-size: 1.875rem;
      line-height: 1.2;
    }
    
    .team-drawer {
      display: none;
    }
  }
  
  @media (min-width: 1024px) {
    .team-sheet {
      display: none;
    }
  }
  
  body.team-dialog-open {
    overflow: hidden;
  }
</style>

<section class="team-carousel section">
  <div class="team-carousel__container">
    <div class="team-carousel__header">
      <div class="team-carousel__header-left">
        {%- if section.settings.eyebrow != blank -%}
          <div class="team-carousel__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="team-carousel__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      
      <div class="team-carousel__controls">
        <button type="button" class="button button--icon" id="carousel-prev" aria-label="Previous practitioners">
          {% render 'icon', icon: 'chevron-left' %}
        </button>
        <button type="button" class="button button--icon" id="carousel-next" aria-label="Next practitioners">
          {% render 'icon', icon: 'chevron-right' %}
        </button>
      </div>
    </div>
    
    <div class="team-carousel__track" id="carousel-track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign team_num = forloop.index0 | modulo: 4 | plus: 1
          assign fallback_file = 'mc-team-0' | append: team_num | append: '.jpg'
          assign first_name = block.settings.name | split: ' ' | first
        -%}
        <button
          type="button"
          class="practitioner-card"
          data-member-index="{{ forloop.index0 }}"
          aria-label="View profile for {{ block.settings.name }}"
          {{ block.shopify_attributes }}
        >
          <div class="practitioner-card__photo-wrap">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 560 }}"
                srcset="{{ block.settings.image | image_url: width: 280 }} 280w,
                        {{ block.settings.image | image_url: width: 560 }} 560w"
                sizes="280px"
                alt="{{ block.settings.name | escape }}"
                class="practitioner-card__photo"
                width="280"
                height="340"
                loading="lazy"
              >
            {%- else -%}
              <img
                src="{{ fallback_file | asset_url }}"
                alt="{{ block.settings.name | escape }}"
                class="practitioner-card__photo"
                width="1200"
                height="1600"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          <div class="practitioner-card__body">
            <h3 class="practitioner-card__name">{{ block.settings.name }}</h3>
            <p class="practitioner-card__role">{{ block.settings.role }}</p>
          </div>
        </button>
      {%- endfor -%}
    </div>
    
    {%- if section.settings.helper_text != blank -%}
      <p class="team-carousel__helper">{{ section.settings.helper_text }}</p>
    {%- endif -%}
  </div>
</section>

<div class="team-dialog-overlay" id="team-overlay" aria-hidden="true"></div>

<div class="team-drawer" id="team-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-name" aria-hidden="true">
  <div class="team-drawer__top-bar">
    <div class="team-drawer__eyebrow">PRACTITIONER</div>
    <button type="button" class="button button--icon" id="drawer-close" aria-label="Close">
      {% render 'icon', icon: 'close' %}
    </button>
  </div>
  
  <div class="team-drawer__photo-wrap">
    <img src="" alt="" class="team-drawer__photo" id="drawer-photo" width="480" height="240">
  </div>
  
  <div class="team-drawer__body">
    <div class="team-drawer__content" id="drawer-content"></div>
  </div>
</div>

<div class="team-sheet" id="team-sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-name" aria-hidden="true">
  <div class="team-sheet__handle"></div>
  
  <div class="team-sheet__top-bar" style="padding: 0 20px 10px;">
    <div class="team-drawer__eyebrow">PRACTITIONER</div>
    <button type="button" class="button button--icon" id="sheet-close" aria-label="Close">
      {% render 'icon', icon: 'close' %}
    </button>
  </div>
  
  <div class="team-sheet__photo-wrap">
    <img src="" alt="" class="team-drawer__photo" id="sheet-photo" width="390" height="160">
  </div>
  
  <div class="team-sheet__body">
    <div class="team-sheet__content" id="sheet-content"></div>
  </div>
</div>

<script type="application/json" id="team-members-data">
  [
    {%- for block in section.blocks -%}
      {%- liquid
        assign team_num = forloop.index0 | modulo: 4 | plus: 1
        assign fallback_file = 'mc-team-0' | append: team_num | append: '.jpg'
        assign first_name = block.settings.name | split: ' ' | first
        assign image_url = block.settings.image | image_url: width: 960
        if block.settings.image == blank
          assign image_url = fallback_file | asset_url
        endif
        assign openings_array = block.settings.next_openings | split: ','
        assign treatments_array = block.settings.treatments_labels | split: ','
      -%}
      {
        "name": {{ block.settings.name | json }},
        "role": {{ block.settings.role | json }},
        "credentials": {{ block.settings.credentials | json }},
        "years": {{ block.settings.years | json }},
        "bio": {{ block.settings.bio | json }},
        "certifications": {{ block.settings.certifications | newline_to_br | split: '<br />' | json }},
        "treatments": [
          {%- for product in block.settings.treatments -%}
            {
              "title": {{ product.title | json }},
              "url": {{ product.url | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "treatmentsLabels": [
          {%- for label in treatments_array -%}
            {{ label | strip | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "openings": [
          {%- for opening in openings_array -%}
            {{ opening | strip | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
        "bookingLink": {{ block.settings.booking_link | default: '/pages/book' | json }},
        "firstName": {{ first_name | json }},
        "imageUrl": {{ image_url | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<script>
(function() {
  const membersData = JSON.parse(document.getElementById('team-members-data').textContent);
  const overlay = document.getElementById('team-overlay');
  const drawer = document.getElementById('team-drawer');
  const sheet = document.getElementById('team-sheet');
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  
  let activeButton = null;
  let focusTrap = null;
  
  // Carousel navigation
  if (prevBtn && nextBtn && track) {
    const cards = track.querySelectorAll('.practitioner-card');
    
    function updateButtons() {
      const scrollLeft = track.scrollLeft;
      const maxScroll = track.scrollWidth - track.clientWidth;
      
      prevBtn.disabled = scrollLeft <= 0;
      nextBtn.disabled = scrollLeft >= maxScroll - 1;
    }
    
    prevBtn.addEventListener('click', () => {
      const cardWidth = cards[0]?.offsetWidth || 280;
      track.scrollBy({ left: -(cardWidth + 16), behavior: 'smooth' });
      setTimeout(updateButtons, 350);
    });
    
    nextBtn.addEventListener('click', () => {
      const cardWidth = cards[0]?.offsetWidth || 280;
      track.scrollBy({ left: cardWidth + 16, behavior: 'smooth' });
      setTimeout(updateButtons, 350);
    });
    
    track.addEventListener('scroll', updateButtons);
    window.addEventListener('resize', updateButtons);
    updateButtons();
  }
  
  // Open dialog
  document.querySelectorAll('.practitioner-card').forEach(card => {
    card.addEventListener('click', function() {
      const index = parseInt(this.dataset.memberIndex);
      activeButton = this;
      openDialog(index);
    });
  });
  
  function openDialog(index) {
    const member = membersData[index];
    if (!member) return;
    
    const isDesktop = window.innerWidth >= 1024;
    const dialog = isDesktop ? drawer : sheet;
    const content = document.getElementById(isDesktop ? 'drawer-content' : 'sheet-content');
    const photo = document.getElementById(isDesktop ? 'drawer-photo' : 'sheet-photo');
    
    // Update photo
    photo.src = member.imageUrl;
    photo.alt = member.name;
    
    // Build content
    let html = '';
    
    // Name & meta
    html += `<h3 class="team-drawer__name" id="${isDesktop ? 'drawer' : 'sheet'}-name">${member.name}</h3>`;
    if (member.credentials || member.years) {
      const parts = [];
      if (member.credentials) parts.push(member.credentials);
      if (member.years) parts.push(member.years);
      html += `<div class="team-drawer__meta">${parts.join(' · ')}</div>`;
    }
    
    // Bio
    if (member.bio) {
      html += `<div class="team-drawer__bio">${member.bio}</div>`;
    }
    
    // Certifications
    if (member.certifications && member.certifications.length > 0 && member.certifications[0].trim()) {
      html += '<div class="team-drawer__section">';
      html += '<div class="team-drawer__section-title">CERTIFICATIONS</div>';
      member.certifications.forEach(cert => {
        if (cert.trim()) {
          html += `<div class="team-drawer__cert-item">
            <span class="team-drawer__cert-icon">${getSvg('check')}</span>
            <span>${cert.trim()}</span>
          </div>`;
        }
      });
      html += '</div>';
    }
    
    // Treatments
    const hasProducts = member.treatments && member.treatments.length > 0;
    const hasLabels = member.treatmentsLabels && member.treatmentsLabels.length > 0 && member.treatmentsLabels[0];
    
    if (hasProducts || hasLabels) {
      html += '<div class="team-drawer__section">';
      html += '<div class="team-drawer__section-title">TREATMENTS OFFERED</div>';
      html += '<div class="team-drawer__chips">';
      
      if (hasProducts) {
        member.treatments.forEach(product => {
          html += `<a href="${product.url}" class="chip chip--outlined">${product.title}</a>`;
        });
      } else if (hasLabels) {
        member.treatmentsLabels.forEach(label => {
          if (label) html += `<span class="chip chip--outlined">${label}</span>`;
        });
      }
      
      html += '</div></div>';
    }
    
    // Next openings
    if (member.openings && member.openings.length > 0 && member.openings[0]) {
      html += '<div class="team-drawer__section">';
      html += '<div class="team-drawer__section-title">NEXT OPENINGS</div>';
      html += '<div class="team-drawer__time-pills">';
      member.openings.forEach((opening, i) => {
        if (opening) {
          html += `<span class="time-pill${i === 0 ? ' is-selected' : ''}">${opening}</span>`;
        }
      });
      html += '</div></div>';
    }
    
    // CTA
    html += `<a href="${member.bookingLink}" class="button button--primary">Book with ${member.firstName}</a>`;
    
    content.innerHTML = html;
    
    // Show dialog
    document.body.classList.add('team-dialog-open');
    overlay.classList.add('is-open');
    dialog.classList.add('is-open');
    dialog.setAttribute('aria-hidden', 'false');
    
    // Focus trap
    setTimeout(() => {
      const closeBtn = document.getElementById(isDesktop ? 'drawer-close' : 'sheet-close');
      if (closeBtn) closeBtn.focus();
      setupFocusTrap(dialog);
    }, 50);
  }
  
  function closeDialog() {
    document.body.classList.remove('team-dialog-open');
    overlay.classList.remove('is-open');
    drawer.classList.remove('is-open');
    sheet.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    sheet.setAttribute('aria-hidden', 'true');
    
    if (activeButton) {
      activeButton.focus();
      activeButton = null;
    }
    
    if (focusTrap) {
      focusTrap = null;
    }
  }
  
  function setupFocusTrap(dialog) {
    const focusableElements = dialog.querySelectorAll(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];
    
    focusTrap = function(e) {
      if (e.key === 'Tab') {
        if (e.shiftKey && document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        } else if (!e.shiftKey && document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      }
    };
    
    dialog.addEventListener('keydown', focusTrap);
  }
  
  function getSvg(icon) {
    if (icon === 'check') {
      return '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
    }
    return '';
  }
  
  // Close handlers
  document.getElementById('drawer-close').addEventListener('click', closeDialog);
  document.getElementById('sheet-close').addEventListener('click', closeDialog);
  overlay.addEventListener('click', closeDialog);
  
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && (drawer.classList.contains('is-open') || sheet.classList.contains('is-open'))) {
      closeDialog();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Team Carousel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE PRACTITIONERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A small roster, known by name."
    },
    {
      "type": "textarea",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Select a practitioner to read their bio, certifications, treatments, and next openings."
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team Member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Dr. Elena Voss"
        },
        {
          "type": "text",
          "id": "role",
