{%- comment -%}
  Main Location Section - Individual location page
{%- endcomment -%}

<style>
  .location-page {
    padding: var(--section-spacing) 0;
  }
  
  .location-page__grid {
    display: grid;
    gap: var(--spacing-2xl);
  }
  
  @media (min-width: 768px) {
    .location-page__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  .location-page__info {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }
  
  .location-page__title {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--spacing-md);
  }
  
  .location-page__description {
    color: var(--color-text-muted);
    line-height: 1.7;
  }
  
  .location-page__detail {
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-stone);
  }
  
  .location-page__detail:last-child {
    border-bottom: none;
  }
  
  .location-page__detail-title {
    font-size: var(--font-size-base);
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .location-page__address {
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  
  .location-page__hours {
    color: var(--color-text-muted);
    line-height: 1.8;
  }
  
  .location-page__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--font-size-lg);
  }
  
  .location-page__phone:hover {
    color: var(--color-accent);
  }
  
  .location-page__map {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-stone);
  }
  
  .location-page__map iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  
  .location-page__treatments {
    margin-top: var(--spacing-2xl);
  }
  
  .location-page__treatments-title {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }
  
  .location-page__booking {
    margin-top: var(--spacing-2xl);
    padding: var(--spacing-xl);
    background-color: var(--color-bg-secondary);
  }
  
  .location-page__booking-title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-md);
    text-align: center;
  }
  
  .location-page__booking-subtitle {
    text-align: center;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-lg);
  }
</style>

<div class="location-page">
  <div class="container">
    <div class="location-page__grid">
      <div class="location-page__info">
        <h1 class="location-page__title">{{ page.title }}</h1>
        
        {%- if page.content != blank -%}
          <div class="location-page__description rte">
            {{ page.content }}
          </div>
        {%- endif -%}
        
        {%- if section.settings.address != blank -%}
          <div class="location-page__detail">
            <div class="location-page__detail-title">Address</div>
            <address class="location-page__address">
              {{ section.settings.address | newline_to_br }}
            </address>
          </div>
        {%- endif -%}
        
        {%- if section.settings.phone != blank -%}
          <div class="location-page__detail">
            <div class="location-page__detail-title">Phone</div>
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}" class="location-page__phone">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              {{ section.settings.phone }}
            </a>
          </div>
        {%- endif -%}
        
        {%- if section.settings.hours != blank -%}
          <div class="location-page__detail">
            <div class="location-page__detail-title">Hours</div>
            <div class="location-page__hours">
              {{ section.settings.hours | newline_to_br }}
            </div>
          </div>
        {%- endif -%}
      </div>
      
      <div class="location-page__map">
        {%- if section.settings.map_embed != blank -%}
          {{ section.settings.map_embed }}
        {%- else -%}
          <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: var(--color-text-muted);">
            Map embed placeholder
          </div>
        {%- endif -%}
      </div>
    </div>
    
    {%- if section.settings.treatments_collection != blank -%}
      <div class="location-page__treatments">
        <h2 class="location-page__treatments-title">Treatments at This Location</h2>
        
        <div class="grid grid--3-col">
          {%- assign treatments = collections[section.settings.treatments_collection].products -%}
          {%- for product in treatments limit: 6 -%}
            {% render 'treatment-card', product: product %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    
    <div class="location-page__booking">
      <h2 class="location-page__booking-title">Book at {{ page.title }}</h2>
      <p class="location-page__booking-subtitle">Schedule your appointment at this location</p>
      
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endif -%}
      {%- endfor -%}
      
      {%- if section.blocks.size == 0 -%}
        <div style="text-align: center;">
          <a 
            href="{{ section.settings.book_link | default: '#book' }}" 
            class="button button--primary"
            data-book-cta
            data-cta-type="book"
            data-treatment-name="Appointment at {{ page.title | escape }}"
          >
            Book Appointment
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Location Page",
  "settings": [
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "123 Main Street\nSuite 100\nCity, State 12345"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "(555) 123-4567"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Hours (one per line)",
      "default": "Monday - Friday: 9am - 7pm\nSaturday: 10am - 5pm\nSunday: Closed"
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Map Embed Code",
      "info": "Paste Google Maps embed iframe code"
    },
    {
      "type": "collection",
      "id": "treatments_collection",
      "label": "Treatments Collection",
      "info": "Show treatments available at this location"
    },
    {
      "type": "url",
      "id": "book_link",
      "label": "Booking Link (if no app block)"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
