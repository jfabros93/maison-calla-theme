<style>
  .product-ingredients {
    padding: var(--spacing-16) 0;
  }
  
  .product-ingredients__header {
    max-width: 600px;
    margin-bottom: var(--spacing-8);
  }
  
  .product-ingredients__eyebrow {
    font-size: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-2);
  }
  
  .product-ingredients__heading {
    font-size: 36px;
    line-height: 42px;
    font-weight: 600;
    margin-bottom: var(--spacing-3);
  }
  
  .product-ingredients__description {
    font-size: 16px;
    line-height: 24px;
    color: var(--color-text-muted);
  }
  
  .product-ingredients__list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }
  
  .ingredient-item {
    padding: var(--spacing-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }
  
  .ingredient-item__name {
    font-weight: 600;
    margin-bottom: var(--spacing-1);
  }
  
  .ingredient-item__description {
    font-size: 15px;
    line-height: 22px;
    color: var(--color-text-muted);
  }
</style>

<section class="product-ingredients section">
  <div class="container">
    <div class="product-ingredients__header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="product-ingredients__eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="product-ingredients__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="product-ingredients__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
    
    {%- if section.blocks.size > 0 -%}
      <div class="product-ingredients__list">
        {%- for block in section.blocks -%}
          <div class="ingredient-item" {{ block.shopify_attributes }}>
            <div class="ingredient-item__name">{{ block.settings.name }}</div>
            <div class="ingredient-item__description">{{ block.settings.description }}</div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "INCI IT NOTES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Short ingredient list. Nothing you need to google."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every formula on our shelf is built for real medical-grade efficacy. Expect visible results, nothing unnecessary."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient Name",
          "default": "Niacinamide 5%"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Strengthens the barrier, reduces redness and calms irritation. Clinically proven at this strength."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Ingredients"
    }
  ]
}
{% endschema %}
