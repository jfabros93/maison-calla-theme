{%- comment -%}
  Main site header with logo, centered pill navigation, and book CTA
{%- endcomment -%}

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-page-bg);
    overflow-x: clip;
  }
  
  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-top: var(--spacing-1);
    padding-bottom: var(--spacing-1);
    gap: var(--spacing-3);
  }
  
  @media (max-width: 1023px) {
    .header__inner {
      display: flex;
      justify-content: space-between;
      padding-top: 8px;
      padding-bottom: 14px;
      padding-left: 20px;
      padding-right: 16px;
      gap: 8px;
    }
  }
  
  .header__logo {
    font-family: var(--font-heading);
    font-size: 22px;
    line-height: 26px;
    font-weight: 600;
    letter-spacing: -0.22px;
    color: var(--color-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  
  @media (max-width: 1023px) {
    .header__logo {
      font-size: 19px;
      line-height: 26px;
      letter-spacing: -0.19px;
      white-space: nowrap;
      gap: 8px;
    }
  }
  
  .header__logo img {
    height: 30px;
    width: auto;
  }
  
  @media (max-width: 1023px) {
    .header__logo img {
      height: 26px;
    }
  }
  
  .header__logo:hover {
    color: var(--color-sage);
  }
  
  .header__logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }
  
  .header__logo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--color-sage);
  }
  
  @media (min-width: 1024px) {
    .header__logo-mark {
      width: 30px;
      height: 30px;
    }
  }
  
  .header__nav {
    display: none;
    justify-content: center;
  }
  
  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
    }
  }
  
  .header__nav-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }
  
  .header__nav-link {
    padding: 10px 18px;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
    border-radius: var(--radius-pill);
    transition: all var(--transition-speed) var(--transition-easing);
  }
  
  .header__nav-link:hover {
    background-color: var(--color-subtle-surface);
  }
  
  .header__nav-link.active {
    background-color: var(--color-subtle-surface);
    color: var(--color-text);
  }
  
  .header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    flex-shrink: 0;
  }
  
  @media (max-width: 1023px) {
    .header__actions {
      gap: 6px;
    }
  }
  
  .header__search-btn,
  .header__cart-btn {
    display: flex;
    width: 44px;
    height: 44px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }
  
  .header__search-btn svg,
  .header__cart-btn svg {
    width: 20px;
    height: 20px;
  }
  
  .header__book-btn {
    display: none;
  }
  
  @media (min-width: 1024px) {
    .header__book-btn {
      display: inline-flex;
    }
  }
  
  .header__menu-toggle {
    display: flex;
    width: 44px;
    height: 44px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }
  
  .header__menu-toggle svg {
    width: 20px;
    height: 20px;
  }
  
  @media (min-width: 1024px) {
    .header__menu-toggle {
      display: none;
    }
  }
  
  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    background-color: var(--color-surface);
    padding: 8px 20px 8px 20px;
    transform: translateX(-100%);
    transition: transform 0.3s var(--transition-easing);
    visibility: hidden;
    pointer-events: none;
  }
  
  .mobile-menu.is-open {
    transform: translateX(0);
    visibility: visible;
    pointer-events: auto;
  }
  
  .mobile-menu__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-8);
  }
  
  .mobile-menu__logo {
    font-family: var(--font-heading);
    font-size: 19px;
    line-height: 26px;
    font-weight: 600;
    letter-spacing: -0.19px;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  
  .mobile-menu__logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }
  
  .mobile-menu__close-btn {
    width: 44px;
    height: 44px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }
  
  .mobile-menu__close-btn svg {
    width: 20px;
    height: 20px;
  }
  
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: var(--spacing-8);
  }
  
  .mobile-menu__link {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-speed) var(--transition-easing);
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: var(--spacing-2) 0;
  }
  
  .mobile-menu__link:hover,
  .mobile-menu__link:focus {
    color: var(--color-sage);
  }
  
  .mobile-menu__book-btn {
    width: 100%;
  }
</style>

<header class="header" role="banner">
  <div class="container">
    <div class="header__inner">
      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if section.settings.logo != blank -%}
          <div class="header__logo-mark">
            <img 
              src="{{ section.settings.logo | image_url: width: 200 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo.width | at_most: 200 }}"
              height="auto"
              loading="eager"
            >
          </div>
        {%- else -%}
          <div class="header__logo-mark">
            <span class="header__logo-dot" aria-hidden="true"></span>
          </div>
          <span>{{ section.settings.logo_text | default: shop.name }}</span>
        {%- endif -%}
      </a>
      
      <nav class="header__nav" role="navigation" aria-label="Main navigation">
        <div class="header__nav-pill">
          {%- for link in section.settings.menu.links -%}
            <a 
              href="{{ link.url }}" 
              class="header__nav-link{% if link.active %} active{% endif %}"
            >
              {{ link.title }}
            </a>
          {%- endfor -%}
        </div>
      </nav>
      
      <div class="header__actions">
        <a 
          href="{{ routes.search_url }}" 
          class="button button--icon header__search-btn" 
          aria-label="Search"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.5"/>
            <path d="M14 14l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        
        <a 
          href="{{ routes.cart_url }}" 
          class="button button--icon header__cart-btn" 
          aria-label="Cart"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 2h3l2.4 12h10.5L19 5H5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="8" cy="18" r="1" fill="currentColor"/>
            <circle cx="16" cy="18" r="1" fill="currentColor"/>
          </svg>
          <span class="visually-hidden">{{ 'cart.general.title' | t }}</span>
        </a>
        
        {%- liquid
          assign book_link = section.settings.book_link
          if book_link == blank and settings.booking_page != blank
            assign book_link = pages[settings.booking_page].url
          endif
        -%}
        
        <a 
          href="{{ book_link | default: '/pages/book' }}" 
          class="button button--primary header__book-btn"
          data-book-cta
          data-cta-type="book"
        >
          {{ section.settings.book_label | default: 'Book now' }}
        </a>
        
        <button 
          type="button" 
          class="button button--icon header__menu-toggle" 
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

{%- comment -%} Mobile Menu {%- endcomment -%}
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile menu">
  <div class="mobile-menu__header">
    <div class="mobile-menu__logo">
      {%- if section.settings.logo != blank -%}
        <div class="mobile-menu__logo-mark">
          <img 
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo.width | at_most: 200 }}"
            height="auto"
            loading="eager"
          >
        </div>
      {%- else -%}
        <div class="mobile-menu__logo-mark">
          <span class="header__logo-dot" aria-hidden="true"></span>
        </div>
        <span>{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    </div>
    <button 
      type="button" 
      class="button button--icon mobile-menu__close-btn" 
      aria-label="Close menu"
      data-menu-close
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 3l14 14M17 3L3 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  
  <nav class="mobile-menu__nav" role="navigation">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" class="mobile-menu__link">
        {{ link.title }}
      </a>
    {%- endfor -%}
  </nav>
  
  <a 
    href="{{ book_link | default: '/pages/book' }}" 
    class="button button--primary mobile-menu__book-btn"
    data-book-cta
    data-cta-type="book"
  >
    {{ section.settings.book_label | default: 'Book Treatment' }}
  </a>
</div>

<script>
  (function() {
    const menuToggle = document.querySelector('[data-menu-toggle]');
    const menuClose = document.querySelector('[data-menu-close]');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuLinks = mobileMenu.querySelectorAll('.mobile-menu__link');
    const bookBtn = mobileMenu.querySelector('.mobile-menu__book-btn');
    let focusableElements = [];
    let firstFocusable = null;
    let lastFocusable = null;
    
    function updateFocusableElements() {
      focusableElements = Array.from(mobileMenu.querySelectorAll('button, a'));
      firstFocusable = focusableElements[0];
      lastFocusable = focusableElements[focusableElements.length - 1];
    }
    
    function trapFocus(e) {
      if (e.key !== 'Tab') return;
      
      if (e.shiftKey) {
        if (document.activeElement === firstFocusable) {
          e.preventDefault();
          lastFocusable.focus();
        }
      } else {
        if (document.activeElement === lastFocusable) {
          e.preventDefault();
          firstFocusable.focus();
        }
      }
    }
    
    function openMenu() {
      mobileMenu.classList.add('is-open');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      updateFocusableElements();
      
      setTimeout(() => {
        if (menuClose) {
          menuClose.focus();
        }
      }, 100);
      
      document.addEventListener('keydown', trapFocus);
    }
    
    function closeMenu() {
      mobileMenu.classList.remove('is-open');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', trapFocus);
      
      if (menuToggle) {
        menuToggle.focus();
      }
    }
    
    if (menuToggle) {
      menuToggle.addEventListener('click', openMenu);
    }
    
    if (menuClose) {
      menuClose.addEventListener('click', closeMenu);
    }
    
    menuLinks.forEach(function(link) {
      link.addEventListener('click', closeMenu);
    });
    
    if (bookBtn) {
      bookBtn.addEventListener('click', closeMenu);
    }
    
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && mobileMenu.classList.contains('is-open')) {
        closeMenu();
      }
    });
    
    mobileMenu.addEventListener('click', function(e) {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "Maison Calla",
      "info": "Used if no logo image is uploaded"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "book_label",
      "label": "Book Button Label",
      "default": "Book now"
    },
    {
      "type": "url",
      "id": "book_link",
      "label": "Book Button Link"
    }
  ]
}
{% endschema %}
