{%- comment -%}
  Main site header with logo, centered pill navigation, and book CTA
{%- endcomment -%}

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-page-bg);
  }
  
  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-top: var(--spacing-1);
    padding-bottom: var(--spacing-1);
    gap: var(--spacing-3);
  }
  
  .header__logo {
    font-family: var(--font-heading);
    font-size: 22px;
    line-height: 26px;
    font-weight: 600;
    letter-spacing: -0.22px;
    color: var(--color-text);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .header__logo img {
    height: 30px;
    width: auto;
  }
  
  .header__logo:hover {
    color: var(--color-sage);
  }
  
  .header__logo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-sage);
  }
  
  .header__nav {
    display: none;
    justify-content: center;
  }
  
  @media (min-width: 1024px) {
    .header__nav {
      display: flex;
    }
  }
  
  .header__nav-pill {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }
  
  .header__nav-link {
    padding: 10px 18px;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
    border-radius: var(--radius-pill);
    transition: all var(--transition-speed) var(--transition-easing);
  }
  
  .header__nav-link:hover {
    background-color: var(--color-subtle-surface);
  }
  
  .header__nav-link.active {
    background-color: var(--color-subtle-surface);
    color: var(--color-text);
  }
  
  .header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }
  
  .header__search-btn,
  .header__cart-btn {
    display: none;
    width: 44px;
    height: 44px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
  }
  
  .header__search-btn svg,
  .header__cart-btn svg {
    width: 20px;
    height: 20px;
  }
  
  @media (min-width: 768px) {
    .header__search-btn,
    .header__cart-btn {
      display: flex;
    }
  }
  
  .header__book-btn {
    display: none;
  }
  
  @media (min-width: 1024px) {
    .header__book-btn {
      display: inline-flex;
    }
  }
  
  .header__menu-toggle {
    display: flex;
  }
  
  @media (min-width: 1024px) {
    .header__menu-toggle {
      display: none;
    }
  }
  
  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    background-color: var(--color-surface);
    padding: var(--spacing-6);
    transform: translateX(-100%);
    transition: transform 0.3s var(--transition-easing);
  }
  
  .mobile-menu.is-open {
    transform: translateX(0);
  }
  
  .mobile-menu__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-8);
  }
  
  .mobile-menu__logo {
    font-family: var(--font-heading);
    font-size: var(--font-size-h3);
    font-weight: 600;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }
  
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    margin-bottom: var(--spacing-8);
  }
  
  .mobile-menu__link {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-speed) var(--transition-easing);
  }
  
  .mobile-menu__link:hover {
    color: var(--color-sage);
  }
  
  .mobile-menu__book-btn {
    width: 100%;
  }
</style>

<header class="header" role="banner">
  <div class="container">
    <div class="header__inner">
      <a href="{{ routes.root_url }}" class="header__logo">
        {%- if section.settings.logo != blank -%}
          <img 
            src="{{ section.settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo.width | at_most: 200 }}"
            height="auto"
            loading="eager"
          >
        {%- else -%}
          <span>{{ section.settings.logo_text | default: shop.name }}</span>
          <span class="header__logo-dot" aria-hidden="true"></span>
        {%- endif -%}
      </a>
      
      <nav class="header__nav" role="navigation" aria-label="Main navigation">
        <div class="header__nav-pill">
          {%- for link in section.settings.menu.links -%}
            <a 
              href="{{ link.url }}" 
              class="header__nav-link{% if link.active %} active{% endif %}"
            >
              {{ link.title }}
            </a>
          {%- endfor -%}
        </div>
      </nav>
      
      <div class="header__actions">
        <button 
          type="button" 
          class="button button--icon header__search-btn" 
          aria-label="Search"
          data-search-toggle
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        
        <a 
          href="{{ routes.cart_url }}" 
          class="button button--icon header__cart-btn" 
          aria-label="Cart"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 2h2.5l2.1 10.5h9.4L17 5H4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="7" cy="16" r="1" fill="currentColor"/>
            <circle cx="14" cy="16" r="1" fill="currentColor"/>
          </svg>
          <span class="visually-hidden">{{ 'cart.general.title' | t }}</span>
        </a>
        
        {%- liquid
          assign book_link = section.settings.book_link
          if book_link == blank and settings.booking_page != blank
            assign book_link = pages[settings.booking_page].url
          endif
        -%}
        
        <a 
          href="{{ book_link | default: '#book' }}" 
          class="button button--primary header__book-btn"
          data-book-cta
          data-cta-type="book"
        >
          {{ section.settings.book_label | default: 'Book now' }}
        </a>
        
        <button 
          type="button" 
          class="button button--icon header__menu-toggle" 
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

{%- comment -%} Mobile Menu {%- endcomment -%}
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true" aria-label="Mobile menu">
  <div class="mobile-menu__header">
    <div class="mobile-menu__logo">
      <span>{{ section.settings.logo_text | default: shop.name }}</span>
      <span class="header__logo-dot" aria-hidden="true"></span>
    </div>
    <button 
      type="button" 
      class="button button--icon" 
      aria-label="Close menu"
      data-menu-close
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>
  
  <nav class="mobile-menu__nav" role="navigation">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}" class="mobile-menu__link">
        {{ link.title }}
      </a>
    {%- endfor -%}
  </nav>
  
  <a 
    href="{{ book_link | default: '#book' }}" 
    class="button button--primary mobile-menu__book-btn"
    data-book-cta
    data-cta-type="book"
  >
    {{ section.settings.book_label | default: 'Book Treatment' }}
  </a>
</div>

<script>
  (function() {
    const menuToggle = document.querySelector('[data-menu-toggle]');
    const menuClose = document.querySelector('[data-menu-close]');
    const mobileMenu = document.getElementById('mobile-menu');
    
    function openMenu() {
      mobileMenu.classList.add('is-open');
      menuToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    
    function closeMenu() {
      mobileMenu.classList.remove('is-open');
      menuToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    
    if (menuToggle) {
      menuToggle.addEventListener('click', openMenu);
    }
    
    if (menuClose) {
      menuClose.addEventListener('click', closeMenu);
    }
    
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && mobileMenu.classList.contains('is-open')) {
        closeMenu();
      }
    });
    
    mobileMenu.addEventListener('click', function(e) {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "Maison Calla",
      "info": "Used if no logo image is uploaded"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "book_label",
      "label": "Book Button Label",
      "default": "Book now"
    },
    {
      "type": "url",
      "id": "book_link",
      "label": "Book Button Link"
    }
  ]
}
{% endschema %}
