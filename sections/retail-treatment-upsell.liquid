{%- comment -%}
  Retail Product Treatment Upsell - Shows 2-3 related treatments
{%- endcomment -%}

<style>
  .treatment-upsell {
    padding: var(--spacing-3xl) 0;
    border-top: 1px solid var(--color-line);
  }
  
  .treatment-upsell__heading {
    font-size: 26px;
    font-weight: 600;
    margin-bottom: var(--spacing-xl);
    text-align: center;
  }
  
  .treatment-upsell__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }
  
  @media (min-width: 768px) {
    .treatment-upsell__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .treatment-upsell__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .treatment-upsell-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }
  
  .treatment-upsell-card__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-beige);
  }
  
  .treatment-upsell-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .treatment-upsell-card__title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  
  .treatment-upsell-card__description {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--spacing-sm);
  }
  
  .treatment-upsell-card__meta {
    display: flex;
    gap: var(--spacing-2);
    flex-wrap: wrap;
    margin-bottom: var(--spacing-sm);
  }
  
  .treatment-upsell-card__price {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: var(--spacing-md);
  }
</style>

{%- liquid
  assign collection_handle = section.settings.treatments_collection | default: 'treatments'
  assign treatments_collection = collections[collection_handle]
  assign treatments_to_show = section.settings.treatments_to_show | default: 3
-%}

{%- if treatments_collection != blank and treatments_collection.products.size > 0 -%}
  <div class="treatment-upsell">
    <div class="container">
      <h2 class="treatment-upsell__heading">
        {{ section.settings.heading | default: "Pairs with your treatment" }}
      </h2>
      
      <div class="treatment-upsell__grid">
        {%- for product in treatments_collection.products limit: treatments_to_show -%}
          {%- liquid
            assign duration = product.metafields.treatment.duration | default: product.metafields.custom.duration | default: '60 min'
            assign downtime = product.metafields.treatment.downtime | default: product.metafields.custom.downtime | default: 'None'
          -%}
          
          <div class="treatment-upsell-card">
            <div class="treatment-upsell-card__image">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="600"
                  height="450"
                  loading="lazy"
                >
              {%- else -%}
                {%- assign product_num = forloop.index | default: 1 | modulo: 6 | plus: 1 -%}
                {%- assign fallback_file = 'mc-treatment-0' | append: product_num | append: '.jpg' -%}
                <img
                  src="{{ fallback_file | asset_url }}"
                  alt="{{ product.title | escape }}, Maison Calla concept"
                  width="1600"
                  height="1200"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            
            <div class="treatment-upsell-card__content">
              <h3 class="treatment-upsell-card__title">{{ product.title }}</h3>
              
              {%- if product.description != blank -%}
                <p class="treatment-upsell-card__description">
                  {{ product.description | strip_html | truncate: 80 }}
                </p>
              {%- endif -%}
              
              <div class="treatment-upsell-card__meta">
                <span class="chip chip--outlined">{{ duration }}</span>
                <span class="chip chip--outlined">{{ downtime }} downtime</span>
              </div>
              
              <div class="treatment-upsell-card__price">
                {{ product.price | money }}
              </div>
              
              <a href="{{ product.url }}" class="button button--secondary button--full-width">
                Book treatment
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Treatment Upsell",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pairs with your treatment"
    },
    {
      "type": "collection",
      "id": "treatments_collection",
      "label": "Treatments Collection",
      "info": "Collection handle defaults to 'treatments' if not set"
    },
    {
      "type": "range",
      "id": "treatments_to_show",
      "label": "Number of Treatments",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
