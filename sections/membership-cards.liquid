{%- comment -%}
  Membership cards section with featured card
{%- endcomment -%}

<style>
  .membership-cards {
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
  }
  
  .membership-cards__grid {
    display: grid;
    gap: var(--spacing-4);
    grid-template-columns: 1fr;
  }
  
  @media (min-width: 768px) {
    .membership-cards__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-6);
    }
  }
  
  .membership-card {
    padding: var(--spacing-6);
    display: flex;
    flex-direction: column;
    min-height: 400px;
  }
  
  .membership-card--featured {
    background-color: var(--color-sage);
    color: var(--color-surface);
  }
  
  .membership-card--featured .membership-card__badge {
    position: absolute;
    top: var(--spacing-3);
    right: var(--spacing-3);
    padding: var(--spacing-1) var(--spacing-2);
    background-color: var(--color-surface);
    color: var(--color-text);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-body-sm);
    font-weight: 600;
  }
  
  .membership-card--featured .membership-card__title,
  .membership-card--featured .membership-card__price,
  .membership-card--featured .membership-card__feature {
    color: var(--color-surface);
  }
  
  .membership-card--featured .membership-card__description {
    color: rgba(249, 249, 249, 0.9);
  }
  
  .membership-card--featured .button--secondary {
    background-color: var(--color-surface);
    color: var(--color-sage-deep);
    border-color: var(--color-surface);
  }
  
  .membership-card--featured .button--secondary:hover {
    background-color: var(--color-surface);
    opacity: 0.9;
  }
  
  .membership-card__title {
    font-size: var(--font-size-h2);
    margin-bottom: var(--spacing-3);
  }
  
  .membership-card__price {
    font-size: var(--font-size-h1);
    font-weight: 600;
    margin-bottom: var(--spacing-1);
  }
  
  .membership-card__price-period {
    font-size: var(--font-size-body-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-4);
  }
  
  .membership-card--featured .membership-card__price-period {
    color: rgba(249, 249, 249, 0.8);
  }
  
  .membership-card__description {
    font-size: var(--font-size-body-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-5);
  }
  
  .membership-card__features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-6) 0;
    flex-grow: 1;
  }
  
  .membership-card__feature {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-2);
    margin-bottom: var(--spacing-3);
    font-size: var(--font-size-body-sm);
  }
  
  .membership-card__feature-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-sage);
  }
  
  .membership-card--featured .membership-card__feature-icon {
    color: var(--color-surface);
  }
</style>

<section class="membership-cards">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow section-header__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="membership-cards__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'membership' -%}
          <div class="membership-card card{% if block.settings.featured %} membership-card--featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.featured -%}
              <span class="membership-card__badge">Most Popular</span>
            {%- endif -%}
            
            <h3 class="membership-card__title">{{ block.settings.title }}</h3>
            
            {%- if block.settings.price != blank -%}
              <div class="membership-card__price">{{ block.settings.price }}</div>
              <div class="membership-card__price-period">{{ block.settings.price_period | default: 'per month' }}</div>
            {%- endif -%}
            
            {%- if block.settings.description != blank -%}
              <p class="membership-card__description">{{ block.settings.description }}</p>
            {%- endif -%}
            
            {%- if block.settings.features != blank -%}
              {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
              <ul class="membership-card__features">
                {%- for feature in features -%}
                  {%- if feature != blank -%}
                    <li class="membership-card__feature">
                      <span class="membership-card__feature-icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M16.667 5L7.5 14.167 3.333 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <span>{{ feature | strip }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="button{% if block.settings.featured %} button--secondary{% else %} button--primary{% endif %} button--full-width">
                {{ block.settings.button_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Membership Cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Memberships"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Invest in your skin"
    }
  ],
  "blocks": [
    {
      "type": "membership",
      "name": "Membership",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Essential"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$99"
        },
        {
          "type": "text",
          "id": "price_period",
          "label": "Price Period",
          "default": "per month"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Perfect for maintaining healthy, glowing skin with consistent care."
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features (one per line)",
          "default": "1 signature facial per month\n10% off all retail products\nPriority booking\nBirthday treatment"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Membership Cards",
      "blocks": [
        {
          "type": "membership",
          "settings": {
            "title": "Essential",
            "price": "$99",
            "description": "Perfect for maintaining healthy, glowing skin with consistent care.",
            "features": "1 signature facial per month\n10% off all retail products\nPriority booking\nBirthday treatment"
          }
        },
        {
          "type": "membership",
          "settings": {
            "title": "Glow Club",
            "price": "$199",
            "description": "Our most popular membership for comprehensive skincare and exclusive perks.",
            "features": "2 treatments per month\n15% off all products\nFree add-on with each visit\nPriority booking\nMember-only events",
            "featured": true
          }
        },
        {
          "type": "membership",
          "settings": {
            "title": "Elite",
            "price": "$349",
            "description": "Complete luxury skincare with unlimited access and VIP benefits.",
            "features": "Unlimited monthly facials\n20% off all products & treatments\nComplimentary enhancements\nVIP concierge booking\nExclusive member events"
          }
        }
      ]
    }
  ]
}
{% endschema %}
