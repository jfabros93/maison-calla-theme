{%- comment -%}
  Collection Product Grid
{%- endcomment -%}

{%- paginate collection.products by section.settings.products_per_page -%}
  <div class="collection-grid section">
    <div class="container">
      {%- if collection.products.size > 0 -%}
        <div class="grid grid--3-col">
          {%- for product in collection.products -%}
            {%- liquid
              assign is_retail = false
              if product.template_suffix == 'retail' or product.type != 'Treatment'
                assign is_retail = true
              endif
            -%}
            {% if is_retail %}
              {% render 'product-card-shop', product: product %}
            {% else %}
              {% render 'treatment-card', product: product %}
            {% endif %}
          {%- endfor -%}
        </div>
        
        {%- if paginate.pages > 1 -%}
          <div style="margin-top: var(--spacing-2xl);">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="collection-empty" style="text-align: center; padding: var(--spacing-2xl);">
          <p style="color: var(--color-text-light); font-size: var(--font-size-lg);">
            No products found in this collection.
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Product Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    }
  ]
}
{% endschema %}
