<style>
  .team-cta-band {
    background: var(--color-sage-soft);
    padding: var(--spacing-8) var(--spacing-10);
  }
  
  .team-cta-band__container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-5);
  }
  
  .team-cta-band__content {
    flex: 1;
  }
  
  .team-cta-band__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-h1);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: var(--spacing-1);
  }
  
  .team-cta-band__subheading {
    font-size: var(--font-size-body-lg);
    line-height: 1.56;
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
  }
  
  @media (max-width: 1023px) {
    .team-cta-band {
      padding: var(--spacing-5) var(--spacing-3);
    }
    
    .team-cta-band__container {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-4);
    }
    
    .team-cta-band__heading {
      font-size: 1.875rem;
      line-height: 1.2;
    }
    
    .team-cta-band__subheading {
      font-size: var(--font-size-body);
    }
  }
</style>

<section class="team-cta-band section">
  <div class="team-cta-band__container">
    <div class="team-cta-band__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="team-cta-band__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="team-cta-band__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    
    {%- if section.settings.button_label != blank -%}
      <a 
        href="{{ section.settings.button_link | default: '/pages/book' }}" 
        class="button button--primary"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Team CTA Band",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start with a consultation."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We'll match you with the right practitioner."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a consultation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "default": "/pages/book"
    }
  ],
  "presets": [
    {
      "name": "Team CTA Band"
    }
  ]
}
{% endschema %}
