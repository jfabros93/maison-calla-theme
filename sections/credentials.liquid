{%- comment -%}
  Credentials strip - Display certifications, awards, and trust signals
{%- endcomment -%}

<style>
  .credentials {
    background-color: var(--color-bg-secondary);
  }
  
  .credentials__header {
    text-align: center;
    margin-bottom: var(--spacing-xl);
  }
  
  .credentials__heading {
    font-size: var(--font-size-xl);
    margin-bottom: var(--spacing-sm);
  }
  
  .credentials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
    text-align: center;
  }
  
  @media (min-width: 768px) {
    .credentials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .credentials__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  
  .credential-item {
    padding: var(--spacing-lg);
  }
  
  .credential-item__icon {
    margin-bottom: var(--spacing-md);
    color: var(--color-accent);
  }
  
  .credential-item__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-base);
    font-weight: 600;
    margin-bottom: var(--spacing-sm);
  }
  
  .credential-item__description {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }
</style>

<section class="credentials section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="credentials__header">
        <h2 class="credentials__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    
    <div class="credentials__grid">
      {%- for block in section.blocks -%}
        <div class="credential-item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="credential-item__icon">
              {% render 'icon', icon: 'check' %}
            </div>
          {%- endif -%}
          
          {%- if block.settings.title != blank -%}
            <h3 class="credential-item__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          
          {%- if block.settings.description != blank -%}
            <p class="credential-item__description">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Credentials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted Expertise"
    }
  ],
  "blocks": [
    {
      "type": "credential",
      "name": "Credential",
      "settings": [
        {
          "type": "checkbox",
          "id": "icon",
          "label": "Show Icon",
          "default": true
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Licensed Providers"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Licensed medical professionals"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Credentials",
      "blocks": [
        {
          "type": "credential",
          "settings": {
            "title": "Licensed Providers",
            "description": "Licensed medical professionals"
          }
        },
        {
          "type": "credential",
          "settings": {
            "title": "15+ Years",
            "description": "Combined experience"
          }
        },
        {
          "type": "credential",
          "settings": {
            "title": "Licensed providers",
            "description": "RNs and NPs, medical director on site"
          }
        },
        {
          "type": "credential",
          "settings": {
            "title": "Safe & Effective",
            "description": "Proven results"
          }
        }
      ]
    }
  ]
}
{% endschema %}
