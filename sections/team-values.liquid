<style>
  .team-values {
    padding: var(--spacing-8) 0;
    background: var(--color-page-bg);
  }
  
  .team-values__container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-10);
  }
  
  .team-values__header {
    margin-bottom: var(--spacing-2);
  }
  
  .team-values__eyebrow {
    font-size: var(--font-size-eyebrow);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-sage-deep);
    margin-bottom: var(--spacing-1);
  }
  
  .team-values__heading {
    font-family: var(--font-heading);
    font-size: var(--font-size-h1);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  
  .team-values__grid {
    display: grid;
    gap: var(--spacing-2);
  }
  
  @media (min-width: 1024px) {
    .team-values__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .value-card {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding: var(--spacing-4);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }
  
  .value-card__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-sage-soft);
    border-radius: var(--radius-pill);
    color: var(--color-sage-deep);
    flex-shrink: 0;
  }
  
  .value-card__title {
    font-family: var(--font-heading);
    font-size: var(--font-size-h3);
    font-weight: 600;
    line-height: 1.37;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  
  .value-card__text {
    font-size: var(--font-size-body);
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--color-text-muted);
  }
  
  @media (max-width: 1023px) {
    .team-values__container {
      padding: 0 var(--spacing-2);
    }
    
    .team-values__heading {
      font-size: 1.875rem;
      line-height: 1.2;
    }
  }
</style>

<section class="team-values section">
  <div class="team-values__container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="team-values__header">
        {%- if section.settings.eyebrow != blank -%}
          <div class="team-values__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="team-values__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    {%- if section.blocks.size > 0 -%}
      <div class="team-values__grid">
        {%- for block in section.blocks -%}
          <div class="value-card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="value-card__icon-wrap">
                {% render 'icon', icon: block.settings.icon %}
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="value-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="value-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Team Values",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHAT WE HOLD TO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A few rules for a quieter kind of spa."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "shield-check",
              "label": "Shield check"
            },
            {
              "value": "sparkles",
              "label": "Sparkles"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            }
          ],
          "default": "shield-check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Clinical rigor"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every injectable visit is physician-led or supervised, with a clear plan before anything is placed."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Values"
    }
  ]
}
{% endschema %}
