{%- comment -%}
  Treatment Cards - Display featured treatments with duration, price, and Book/Consult CTA
{%- endcomment -%}

<style>
  .treatment-cards {
    background-color: var(--color-bg);
  }
  
  .treatment-cards__header {
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }
  
  .treatment-cards__heading {
    font-size: var(--font-size-2xl);
    margin-bottom: var(--spacing-md);
  }
  
  .treatment-cards__subheading {
    color: var(--color-text-light);
    font-size: var(--font-size-lg);
  }
  
  .treatment-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
  
  @media (min-width: 768px) {
    .treatment-cards__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (min-width: 1024px) {
    .treatment-cards__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<section class="treatment-cards section">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="treatment-cards__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="treatment-cards__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        
        {%- if section.settings.subheading != blank -%}
          <p class="treatment-cards__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    
    <div class="treatment-cards__grid">
      {%- if section.settings.collection != blank -%}
        {%- assign treatments = collections[section.settings.collection].products | default: collections[section.settings.collection].products -%}
        {%- assign limit = section.settings.products_to_show | default: 6 -%}
        
        {%- for product in treatments limit: limit -%}
          {% render 'treatment-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder cards {%- endcomment -%}
        {%- for i in (1..3) -%}
          <div class="card treatment-card">
            {{ 'product-1' | placeholder_svg_tag: 'card__image' }}
            <div class="card__content">
              <div class="treatment-card__meta">
                <span class="treatment-card__duration">
                  {% render 'icon', icon: 'clock' %} 60 min
                </span>
                <span class="treatment-card__price">From $150</span>
              </div>
              
              <h3 class="treatment-card__title">Treatment {{ i }}</h3>
              <p class="treatment-card__description">
                Experience our signature treatment designed to rejuvenate and restore.
              </p>
              
              <div class="treatment-card__cta">
                <a href="#" class="button button--full-width" data-book-cta data-cta-type="book">
                  {{ settings.booking_button_label | default: 'Book Treatment' }}
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    
    {%- if section.settings.view_all_link != blank -%}
      <div style="text-align: center; margin-top: var(--spacing-xl);">
        <a href="{{ section.settings.view_all_link }}" class="button">
          {{ section.settings.view_all_label | default: 'View All Treatments' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Treatment Cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Treatments"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our range of clinically-proven treatments"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Treatment Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of Treatments",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Label",
      "default": "View All Treatments"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Button Link"
    }
  ],
  "presets": [
    {
      "name": "Treatment Cards"
    }
  ]
}
{% endschema %}
