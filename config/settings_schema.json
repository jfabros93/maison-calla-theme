  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Headings"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "manrope_n6",
        "info": "Manrope 600 for headings"
      },
      {
        "type": "header",
        "content": "Body Text"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "inter_n4",
        "info": "Inter for body and UI"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "spacing_base",
        "label": "Base Spacing Unit",
        "min": 4,
        "max": 16,
        "step": 2,
        "unit": "px",
        "default": 8,
        "info": "Base unit for spacing scale (8px default)"
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Section Spacing",
        "min": 48,
        "max": 120,
        "step": 8,
        "unit": "px",
        "default": 80
      },
      {
        "type": "header",
        "content": "Border Radius"
      },
      {
        "type": "range",
        "id": "radius_sm",
        "label": "Small Radius",
        "min": 8,
        "max": 16,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "range",
        "id": "radius_md",
        "label": "Medium Radius",
        "min": 16,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "radius_lg",
        "label": "Large Radius",
        "min": 24,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 28
      },
      {
        "type": "range",
        "id": "radius_xl",
        "label": "Extra Large Radius",
        "min": 32,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 36
      },
      {
        "type": "header",
        "content": "Container"
      },
      {
        "type": "range",
        "id": "container_max_width",
        "label": "Max Width",
        "min": 1200,
        "max": 2200,
        "step": 100,
        "unit": "px",
        "default": 1600
      }
    ]
  },
  {
    "name": "Mobile Book Bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "mobile_book_bar_enabled",
        "label": "Enable Mobile Book Bar",
        "default": true,
        "info": "Pinned booking button at bottom of mobile screens"
      },
      {
        "type": "text",
        "id": "mobile_book_bar_label",
        "label": "Button Label",
        "default": "Book Treatment"
      },
      {
        "type": "url",
        "id": "mobile_book_bar_link",
        "label": "Button Link",
        "info": "Link to booking page or leave empty for app integration"
      },
      {
        "type": "textarea",
        "id": "mobile_book_bar_app_trigger",
        "label": "App Trigger Code (Optional)",
        "info": "JavaScript code to trigger booking app modal, e.g., window.bookingApp.open()"
      }
    ]
  },
  {
    "name": "Booking",
    "settings": [
      {
        "type": "header",
